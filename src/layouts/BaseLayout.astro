---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SellerAnalysisCta from "../components/SellerAnalysisCta.astro";

import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "@fontsource/playfair-display/700.css";
import "@fontsource/playfair-display/700-italic.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  type?: string;
  suppressAgentSchema?: boolean;
  /** Price and CMA pages omit the appraiser credential from hidden schema. */
  omitAppraiserSchema?: boolean;
  noindex?: boolean;
  exactTitle?: boolean;
}

const { title, description, image, canonicalUrl, type, suppressAgentSchema, omitAppraiserSchema = false, noindex, exactTitle } = Astro.props;

// Private investor / other-broker pages are noindex and live under /p/.
// The public seller CTA stays off those pages.
const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/\/+$/, "") || "/";
const isPrivate = Boolean(noindex) || pathname.startsWith("/p/");
const hideSellerCta = isPrivate || normalizedPath === "/about";
const onSellerTool = normalizedPath === "/tools/home-price";
// Seller, price, listing, and area routes omit the appraiser credential.
// Blog posts and /about keep it.
const omitAppraiserByRoute =
  normalizedPath === "/" ||
  normalizedPath === "/selling" ||
  normalizedPath === "/listings" ||
  normalizedPath === "/land" ||
  normalizedPath === "/cabins" ||
  normalizedPath === "/buying-rural" ||
  normalizedPath === "/contact" ||
  normalizedPath === "/areas" ||
  normalizedPath.startsWith("/areas/") ||
  normalizedPath === "/tools" ||
  normalizedPath === "/tools/home-price" ||
  normalizedPath === "/tools/seller-net";
const omitAppraiser = omitAppraiserSchema || omitAppraiserByRoute;

// Site-wide RealEstateAgent structured data — establishes the business
// entity for search engines and AI systems on every page.
const agentCredentials = [
  {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "license",
    name: "Utah Real Estate Agent License",
    recognizedBy: { "@type": "Organization", name: "Utah Division of Real Estate" },
  },
  ...(omitAppraiser
    ? []
    : [
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "license",
          name: "Certified Residential Appraiser",
          recognizedBy: { "@type": "Organization", name: "Utah Division of Real Estate" },
        },
      ]),
];

const realEstateAgentSchema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "Mike Price",
  description: omitAppraiser
    ? "Mike Price has spent over two decades working in Central Utah real estate. Central Utah REALTOR®. Service area: Juab, Sanpete, Millard & Sevier Counties."
    : "Central & rural Utah REALTOR® and certified residential appraiser with 20 years of local market expertise. Service area: Juab, Sanpete, Millard & Sevier Counties.",
  url: "https://mikesellsut.com",
  image: "https://mikesellsut.com/images/site/mike-headshot.jpg",
  telephone: "+14356600401",
  email: "mikesellsut@gmail.com",
  address: {
    "@type": "PostalAddress",
    postOfficeBoxNumber: "431",
    addressLocality: "Spring City",
    addressRegion: "UT",
    postalCode: "84662",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Sanpete County, Utah" },
    { "@type": "AdministrativeArea", name: "Sevier County, Utah" },
    { "@type": "AdministrativeArea", name: "Millard County, Utah" },
    { "@type": "AdministrativeArea", name: "Juab County, Utah" },
  ],
  hasCredential: agentCredentials,
  knowsAbout: [
    "Residential real estate",
    "Land and rural property",
    "Cabin and mountain properties",
    "Rural property pricing",
    "Water rights in Utah",
    "Agricultural land",
    "Manufactured homes (HUD code) and modular homes",
    "Conventional financing",
    "FHA financing",
    "USDA Rural Development loans",
    "Sanpete County real estate",
    "Sevier County real estate",
    "Millard County real estate",
    "Juab County real estate",
  ],
  memberOf: {
    "@type": "Organization",
    name: "Heritage Realty Group, LLC",
  },
  sameAs: [
    "https://www.instagram.com/mikesellsut",
    "https://www.facebook.com/profile.php?id=61577587227657",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      image={image}
      canonicalUrl={canonicalUrl}
      type={type}
      noindex={noindex}
      exactTitle={exactTitle}
    />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QMXYY3Z3FT"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-QMXYY3Z3FT");
    </script>


    {!suppressAgentSchema && <script type="application/ld+json" set:html={JSON.stringify(realEstateAgentSchema)} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Netlify Identity Widget (for CMS login) -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-navy font-body">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    {!hideSellerCta && <SellerAnalysisCta onToolPage={onSellerTool} />}
    <Footer />

    <!-- Netlify Identity redirect after login -->
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", function (user) {
          if (!user) {
            window.netlifyIdentity.on("login", function () {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Single-element reveals (headings, text blocks, etc). GSAP + ScrollTrigger
      // is a good fit here: one target, one trigger, no cross-element timing.
      ScrollTrigger.matchMedia({
        "(min-width: 768px)": function () {
          document.querySelectorAll("[data-animate]").forEach((el) => {
            gsap.from(el, {
              scrollTrigger: { trigger: el, start: "top 85%", once: true },
              y: 30,
              opacity: 0,
              duration: 0.8,
              ease: "power2.out",
            });
          });
        },
        "(max-width: 767px)": function () {
          document.querySelectorAll("[data-animate]").forEach((el) => {
            gsap.from(el, {
              scrollTrigger: { trigger: el, start: "top 90%", once: true },
              opacity: 0,
              duration: 0.6,
              ease: "power2.out",
            });
          });
        },
      });

      // Staggered card-grid reveals ([data-animate-stagger] containers).
      // Deliberately NOT built on GSAP ScrollTrigger: a trigger-container /
      // animate-children split here reproducibly failed in production — the
      // tween would start (confirmed mid-flight at ~30% opacity via direct
      // tween/ScrollTrigger inspection) and then silently snap back to its
      // opacity:0 "from" state before finishing, every time, regardless of
      // toggleActions/once config or scroll method (jump, key, real trusted
      // wheel input all reproduced it). Root cause not fully isolated; rather
      // than ship a fragile animation nobody can safely touch, this uses a
      // plain IntersectionObserver + CSS transition instead — no scroll-
      // position math to desync, so there's nothing to snap back.
      const staggerObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        // threshold 0: a tall one-column grid on a phone can never be 15% on screen,
        // which left blog posts invisible on mobile.
        { threshold: 0, rootMargin: "0px 0px -10% 0px" }
      );
      document.querySelectorAll("[data-animate-stagger]").forEach((container) => {
        staggerObserver.observe(container);
      });
    </script>
  </body>
</html>
