---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "@fontsource/playfair-display/700.css";
import "@fontsource/playfair-display/700-italic.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  type?: string;
}

const { title, description, image, canonicalUrl, type } = Astro.props;

// Site-wide RealEstateAgent structured data — establishes the business
// entity for search engines and AI systems on every page.
const realEstateAgentSchema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "Mike Price",
  description: "Central Utah REALTOR® and certified residential appraiser with 20 years of local market expertise. Specializing in residential homes, land, cabins, and rural properties across Sanpete, Sevier, Millard & Juab Counties.",
  url: "https://mikesellsut.com",
  image: "https://mikesellsut.com/images/site/mike-headshot.jpg",
  telephone: "+14356600401",
  email: "mikesellsut@gmail.com",
  address: {
    "@type": "PostalAddress",
    postOfficeBoxNumber: "431",
    addressLocality: "Spring City",
    addressRegion: "UT",
    postalCode: "84662",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Sanpete County, Utah" },
    { "@type": "AdministrativeArea", name: "Sevier County, Utah" },
    { "@type": "AdministrativeArea", name: "Millard County, Utah" },
    { "@type": "AdministrativeArea", name: "Juab County, Utah" },
  ],
  hasCredential: [
    {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "license",
      name: "Utah Real Estate Agent License",
      recognizedBy: { "@type": "Organization", name: "Utah Division of Real Estate" },
    },
    {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "license",
      name: "Certified Residential Appraiser",
      recognizedBy: { "@type": "Organization", name: "Utah Division of Real Estate" },
    },
  ],
  knowsAbout: [
    "Residential real estate",
    "Land and rural property",
    "Cabin and mountain properties",
    "Property appraisal and valuation",
    "Rural property pricing",
    "Water rights in Utah",
    "Agricultural land",
    "Manufactured and modular homes",
    "Conventional financing",
    "FHA financing",
    "USDA Rural Development loans",
    "Sanpete County real estate",
    "Sevier County real estate",
    "Millard County real estate",
    "Juab County real estate",
  ],
  memberOf: {
    "@type": "Organization",
    name: "Heritage Realty Group LLC",
  },
  sameAs: [
    "https://www.instagram.com/mikesellsut",
    "https://www.facebook.com/profile.php?id=61577587227657",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      image={image}
      canonicalUrl={canonicalUrl}
      type={type}
    />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QMXYY3Z3FT"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-QMXYY3Z3FT");
    </script>


    <script type="application/ld+json" set:html={JSON.stringify(realEstateAgentSchema)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Netlify Identity Widget (for CMS login) -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-navy font-body">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Netlify Identity redirect after login -->
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", function (user) {
          if (!user) {
            window.netlifyIdentity.on("login", function () {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Single-element reveals (headings, text blocks, etc). GSAP + ScrollTrigger
      // is a good fit here: one target, one trigger, no cross-element timing.
      ScrollTrigger.matchMedia({
        "(min-width: 768px)": function () {
          document.querySelectorAll("[data-animate]").forEach((el) => {
            gsap.from(el, {
              scrollTrigger: { trigger: el, start: "top 85%", once: true },
              y: 30,
              opacity: 0,
              duration: 0.8,
              ease: "power2.out",
            });
          });
        },
        "(max-width: 767px)": function () {
          document.querySelectorAll("[data-animate]").forEach((el) => {
            gsap.from(el, {
              scrollTrigger: { trigger: el, start: "top 90%", once: true },
              opacity: 0,
              duration: 0.6,
              ease: "power2.out",
            });
          });
        },
      });

      // Staggered card-grid reveals ([data-animate-stagger] containers).
      // Deliberately NOT built on GSAP ScrollTrigger: a trigger-container /
      // animate-children split here reproducibly failed in production — the
      // tween would start (confirmed mid-flight at ~30% opacity via direct
      // tween/ScrollTrigger inspection) and then silently snap back to its
      // opacity:0 "from" state before finishing, every time, regardless of
      // toggleActions/once config or scroll method (jump, key, real trusted
      // wheel input all reproduced it). Root cause not fully isolated; rather
      // than ship a fragile animation nobody can safely touch, this uses a
      // plain IntersectionObserver + CSS transition instead — no scroll-
      // position math to desync, so there's nothing to snap back.
      const staggerObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
      );
      document.querySelectorAll("[data-animate-stagger]").forEach((container) => {
        staggerObserver.observe(container);
      });
    </script>
  </body>
</html>
