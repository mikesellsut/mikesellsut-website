---
// One listing card on /listings. Used for both active and recently sold
// listings. Sold cards never show a price or MLS link (Utah is a
// non-disclosure state, so sold prices stay private).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Listing, ListingPhoto, ListingStatus } from "../data/listings";

export interface ListingCardData extends Listing {
  priceText: string | null;
  facts: string[];
  location: string;
  images: (ListingPhoto & { src: ImageMetadata })[];
}

interface Props {
  card: ListingCardData;
  /** Load the hero eagerly (first card on the page only). */
  eager?: boolean;
}

const { card, eager = false } = Astro.props;
const isSold = card.status === "Sold";
// Active cards sit under the page h1; sold cards sit under the "Recently Sold" h2.
const Heading = isSold ? "h3" : "h2";

const statusClass: Record<ListingStatus, string> = {
  Active: "bg-gold text-white",
  "Under Contract": "bg-red text-white",
  Sold: "bg-navy text-white",
};
---

<article
  id={card.id}
  class="listing-card scroll-mt-24 bg-white rounded-lg overflow-hidden shadow-md border border-navy/5 grid grid-cols-1 lg:grid-cols-12"
  data-status={card.status}
>
  <!-- Photos -->
  <div class="lg:col-span-7">
    <div class="relative aspect-[16/10] overflow-hidden bg-navy/5">
      <a
        href={card.images[0].src.src}
        target="_blank"
        rel="noopener"
        class="listing-photo-link block w-full h-full"
        data-listing={card.id}
        data-lightbox={card.id}
        data-full={card.images[0].src.src}
        data-alt={card.images[0].alt}
        data-altered={card.images[0].digitallyAltered ? "true" : undefined}
        aria-label={`View photos: ${card.title}`}
      >
        <Image
          src={card.images[0].src}
          alt={card.images[0].alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 640px, 100vw"
          class="w-full h-full object-cover"
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : undefined}
        />
      </a>
      {card.images[0].digitallyAltered && (
        <span class="pointer-events-none absolute bottom-3 left-3 px-2 py-0.5 rounded bg-navy/80 text-white font-body text-xs">
          Digitally altered
        </span>
      )}
      <span
        class:list={[
          "pointer-events-none absolute top-4 left-4 rounded-md font-heading uppercase tracking-wider font-bold shadow-md",
          isSold ? "px-4 py-1.5 text-sm border-2 border-gold" : "px-3 py-1 text-xs",
          statusClass[card.status],
        ]}
      >
        {card.status}
      </span>
    </div>
    {card.images.length > 1 && (
      <ul class="grid grid-cols-5 gap-1 p-1 bg-white" aria-label={`More photos: ${card.title}`}>
        {card.images.slice(1).map((photo) => (
          <li>
            <a
              href={photo.src.src}
              target="_blank"
              rel="noopener"
              class="listing-photo-link relative block aspect-[4/3] overflow-hidden rounded-sm group"
              data-listing={card.id}
              data-lightbox={card.id}
              data-full={photo.src.src}
              data-alt={photo.alt}
              data-altered={photo.digitallyAltered ? "true" : undefined}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                width={320}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              {photo.digitallyAltered && (
                <span class="absolute inset-x-0 bottom-0 bg-navy/80 text-white font-body text-[10px] leading-tight text-center px-1 py-0.5">
                  Digitally altered
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Details -->
  <div class="lg:col-span-5 p-6 md:p-8 flex flex-col">
    <p class="font-heading text-sm text-gold uppercase tracking-wider font-semibold mb-2">
      {card.type} · {card.town}
    </p>
    <Heading class="font-heading text-2xl text-navy uppercase tracking-wide mb-3">
      {card.title}
    </Heading>
    {!isSold && card.priceText && (
      <p class="font-display text-3xl text-navy mb-3">{card.priceText}</p>
    )}
    {card.facts.length > 0 && (
      <ul class="flex flex-wrap gap-2 mb-3">
        {card.facts.map((fact) => (
          <li class="px-3 py-1 bg-cream border border-navy/10 rounded-md font-body text-sm text-navy font-semibold">
            {fact}
          </li>
        ))}
      </ul>
    )}
    <p class="font-body text-sm text-navy/60 mb-4">{card.location}</p>
    <p class="font-body text-navy/80 leading-relaxed mb-6">{card.blurb}</p>

    <div class="mt-auto">
      <div class="flex flex-col sm:flex-row gap-3">
        {!isSold && card.mlsUrl && (
          <a
            href={card.mlsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 bg-navy text-white font-heading uppercase tracking-wider text-sm rounded-md hover:bg-sky transition-colors duration-200 text-center"
          >
            View on MLS
          </a>
        )}
        <a
          href="/contact"
          class="inline-block px-6 py-3 bg-gold text-white font-heading uppercase tracking-wider text-sm rounded-md hover:brightness-110 transition-all duration-200 shadow-md text-center"
        >
          {isSold ? "Selling Something Similar?" : "Contact Mike"}
        </a>
      </div>
      <p class="mt-4 font-body text-xs text-navy/50">
        {isSold
          ? "Sold · Listed with Heritage Realty Group"
          : `${card.mlsNumber ? `MLS #${card.mlsNumber} · ` : ""}Listed with Heritage Realty Group`}
      </p>
    </div>
  </div>
</article>
