---
// Short "See what's for sale" call-out linking to /listings/.
// Pass `featured` (a listing id from src/data/listings.ts) to add a direct
// link to one listing; it only shows while that listing is Active.
import { listings } from "../data/listings";

interface Props {
  featured?: string;
  class?: string;
}

const { featured, class: className = "" } = Astro.props;
const activeCount = listings.filter((l) => l.status === "Active").length;
const pick = featured ? listings.find((l) => l.id === featured && l.status === "Active") : undefined;
---

<section class:list={["py-10 px-4 sm:px-6 lg:px-8", className]}>
  <div class="max-w-3xl mx-auto bg-navy rounded-lg p-6 md:p-8 text-center shadow-md border-b-4 border-gold">
    <h2 class="font-heading text-2xl text-white uppercase tracking-wide mb-2">See What's for Sale</h2>
    <p class="font-body text-white/80 mb-5">
      {activeCount > 0
        ? "Cabins, land, and homes I currently have listed in Central Utah, with photos, prices, and acreage."
        : "New Central Utah listings are coming soon. Take a look or ask me what's about to hit the market."}
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="/listings/"
        class="inline-block px-6 py-3 bg-gold text-white font-heading uppercase tracking-wider text-sm rounded-md hover:brightness-110 transition-all duration-200 shadow-md"
      >
        View Current Listings
      </a>
      {pick && (
        <a
          href={`/listings/#${pick.id}`}
          class="inline-block px-6 py-3 bg-transparent border-2 border-white text-white font-heading uppercase tracking-wider text-sm rounded-md hover:bg-white hover:text-navy transition-all duration-200"
        >
          {pick.town}: {pick.title}
        </a>
      )}
    </div>
  </div>
</section>
