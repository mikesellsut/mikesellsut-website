---
// Shared layout for a private client detail page. Matches the Clements Lane
// page: hero, facts, aerial as location context, specs, PhotoLightbox, and
// Mike Price as the only contact.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoLightbox from "./PhotoLightbox.astro";
import heritageLogo from "../assets/heritage-logo.png";
import { portfolioBase, type PortfolioListing, type Photo } from "../data/debbiePortfolio";

interface Props {
  listing: PortfolioListing;
  photos: Photo[];
}

const { listing, photos } = Astro.props;
const base = `${portfolioBase}/${listing.mls}`;
const hero = photos[0];
const total = photos.length;
const address = `${listing.street}, ${listing.town}, ${listing.stateZip}`;
const mapQuery = listing.mapQuery;
const aerialEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&hl=en&t=k&z=16&output=embed`;
const aerialLink = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&t=k&z=16`;
const mailSubject = encodeURIComponent(`${listing.title} (MLS #${listing.mls})`);

const jumps = [
  ["All properties", `${portfolioBase}/`],
  ["The property", "#property"],
  ["Land and water", "#land"],
  ["Aerial", "#aerial"],
  ["House", "#house"],
  ["Photos", "#photos"],
  ["Next steps", "#next"],
];
---

<BaseLayout
  title={listing.title}
  exactTitle={true}
  description={`${listing.statusLabel} listing for ${address}, presented by Mike Price, REALTOR®, Heritage Realty Group. MLS #${listing.mls} asks $${listing.price.toLocaleString("en-US")} for the ${listing.sqft.toLocaleString("en-US")} sq ft ${listing.kind.toLowerCase()} on ${listing.acres} acres.`}
  image={`${base}/photos/${hero[0]}`}
  noindex={true}
>
  <section class="relative bg-navy">
    <img
      src={`${base}/photos/${hero[0]}`}
      width={hero[1]}
      height={hero[2]}
      alt={`${address}, from the public listing photos`}
      class="w-full h-[68vh] min-h-[320px] max-h-[760px] object-cover"
      fetchpriority="high"
      decoding="async"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy via-navy/45 to-navy/10"></div>
    <div class="absolute inset-x-0 bottom-0 px-4 sm:px-6 lg:px-8 pb-8 md:pb-12">
      <div class="max-w-6xl mx-auto">
        <p class="pointer-events-auto mb-3">
          <a href={`${portfolioBase}/`} class="font-heading text-xs sm:text-sm uppercase tracking-[0.16em] text-gold hover:text-white">← Properties for Debbie Hennessy</a>
        </p>
        <p class="font-heading text-xs sm:text-sm uppercase tracking-[0.2em] text-gold mb-2">{listing.statusLabel}</p>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl text-white leading-tight max-w-4xl">{listing.title}</h1>
        <p class="mt-3 text-base sm:text-lg text-cream/95">{address}</p>
        <p class="mt-1 text-sm sm:text-base text-cream/80">{listing.county} County · MLS #{listing.mls} · Listed at ${listing.price.toLocaleString("en-US")}</p>
        <p class="mt-1 text-sm sm:text-base text-cream/80">Presented by Mike Price, REALTOR&reg;, Heritage Realty Group</p>
        <p class="mt-4 max-w-2xl text-base sm:text-lg text-white leading-snug">{listing.hook}</p>
        {listing.statusNote && <p class="mt-3 max-w-2xl text-sm text-cream/80 leading-snug">{listing.statusNote}</p>}
        <p class="mt-5 pointer-events-auto">
          <a href="#photos" class="inline-block bg-gold text-navy font-semibold uppercase tracking-wide text-sm px-5 py-3 rounded hover:bg-white">View {total} photos</a>
        </p>
      </div>
    </div>
  </section>
  <div class="h-1 bg-gold"></div>

  <nav class="sticky top-16 md:top-20 z-40 bg-cream/95 backdrop-blur border-b border-navy/10" aria-label="On this page">
    <ul class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-1 sm:gap-2 overflow-x-auto py-2">
      {jumps.map(([label, href]) => (
        <li class="shrink-0">
          <a href={href} class="inline-block font-heading text-xs sm:text-sm uppercase tracking-wider text-navy px-3 py-2 rounded hover:bg-navy hover:text-white">{label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <section id="property" class="px-4 sm:px-6 lg:px-8 py-10 md:py-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <h2 class="font-display text-3xl text-navy mb-4">{listing.street}</h2>
        {listing.summary.map((paragraph) => (
          <p class="mt-4 first:mt-0 text-navy/85 leading-relaxed text-lg">{paragraph}</p>
        ))}
      </div>
      <aside class="bg-navy text-white rounded-lg p-6 shadow-md h-fit">
        <div class="flex items-center gap-4 mb-4">
          <img src="/images/site/mike-headshot.jpg" alt="Mike Price, REALTOR®" width="72" height="72" class="w-16 h-16 rounded-full object-cover border-2 border-gold" decoding="async" />
          <div>
            <p class="font-display text-xl">Mike Price</p>
            <p class="text-cream/80 text-sm">REALTOR&reg;</p>
            <p class="text-cream/80 text-sm">Heritage Realty Group, LLC</p>
          </div>
        </div>
        <p class="text-cream/90 mb-4">For this listing, contact Mike.</p>
        <address class="not-italic text-cream/80 text-sm leading-relaxed mb-5">
          P.O. Box 431<br />Spring City, UT 84662
        </address>
        <div class="space-y-3">
          <a href="tel:4356600401" class="block text-center bg-gold text-navy font-semibold uppercase tracking-wide text-sm px-4 py-3 rounded hover:bg-white">Call or Text 435-660-0401</a>
          <a href={`mailto:mikesellsut@gmail.com?subject=${mailSubject}`} class="block text-center border border-gold text-gold font-semibold uppercase tracking-wide text-sm px-4 py-3 rounded hover:bg-gold hover:text-navy break-words">Email mikesellsut@gmail.com</a>
        </div>
        <div class="mt-6 pt-5 border-t border-white/15 flex justify-center">
          <div class="bg-white rounded px-3 py-2">
            <Image src={heritageLogo} alt="Heritage Realty Group, LLC" width={200} class="h-10 w-auto" />
          </div>
        </div>
      </aside>
    </div>
    <dl class="max-w-6xl mx-auto mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {listing.facts.map(([label, value]) => (
        <div class="bg-white rounded-lg p-4 shadow-sm border border-navy/5">
          <dt class="font-heading text-xs uppercase tracking-[0.14em] text-gold font-semibold">{label}</dt>
          <dd class="mt-2 text-navy leading-snug">{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="px-4 sm:px-6 lg:px-8 pb-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-3">
      {photos.slice(0, 3).map(([file, w, h], i) => (
        <a href="#photos" class="block overflow-hidden rounded-lg bg-navy aspect-[4/3]">
          <img src={`${base}/photos/${file}`} width={w} height={h} alt={`${listing.title} listing photo ${i + 1} of ${total}`} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </section>

  <section id="land" class="px-4 sm:px-6 lg:px-8 py-10 md:py-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4">
      {listing.pillars.map((pillar, i) => (
        <article class:list={["rounded-lg p-6 shadow-sm", i === 1 ? "bg-navy text-white" : "bg-white text-navy border border-navy/5"]}>
          <h2 class="font-display text-2xl mb-3">{pillar.title}</h2>
          <p class:list={["leading-relaxed", i === 1 ? "text-cream/90" : "text-navy/80"]}>{pillar.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="aerial" class="px-4 sm:px-6 lg:px-8 pb-10 md:pb-14 scroll-mt-32" aria-labelledby="aerial-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="aerial-heading" class="font-display text-3xl text-navy mb-2">Aerial overview</h2>
      <p class="text-navy/70 mb-4 max-w-3xl">Aerial view of {address}. Location context, not a boundary survey.</p>
      <div class="rounded-lg overflow-hidden border border-navy/10 bg-white h-80 sm:h-96 lg:h-[420px]">
        <iframe
          src={aerialEmbed}
          title={`Aerial view of ${address}. Location context only, not sale boundaries.`}
          class="w-full h-full"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p class="mt-3">
        <a href={aerialLink} class="text-navy font-semibold underline decoration-gold decoration-2 underline-offset-4 hover:text-gold" target="_blank" rel="noopener noreferrer">Open {address} in Google Maps (location context)</a>
      </p>
      <p class="mt-1 text-xs text-navy/55">Aerial imagery: Google Maps. Provider credits are on the map. Location context, not a boundary survey.</p>
    </div>
  </section>

  <section id="house" class="px-4 sm:px-6 lg:px-8 pb-10 md:pb-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display text-3xl text-navy mb-2">The house</h2>
      <p class="text-navy/70 mb-6 max-w-3xl">{listing.beds} bedrooms and {listing.baths} baths on the public header. {listing.sqft.toLocaleString("en-US")} sq ft is the listing total. The floor split is in the specifications.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {listing.improvements.map(([title, copy]) => (
          <div class="bg-white rounded-lg p-4 border border-navy/5">
            <h3 class="font-heading text-xs uppercase tracking-[0.14em] text-gold font-semibold">{title}</h3>
            <p class="mt-2 text-navy/80 leading-relaxed">{copy}</p>
          </div>
        ))}
      </div>
      <details class="mt-4 bg-white rounded-lg border border-navy/5 px-4 py-4 sm:px-6" open>
        <summary class="cursor-pointer font-display text-2xl text-navy">Full listing specifications</summary>
        <p class="mt-2 text-sm text-navy/60">Public fields from the listing. Where a field is blank on that page, the row says so.</p>
        <div class="mt-6 space-y-8">
          {listing.specGroups.map((group) => (
            <div>
              <h4 class="font-display text-xl text-navy mb-3 pb-2 border-b-2 border-gold/60">{group.title}</h4>
              <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
                {group.rows.map(([label, value]) => (
                  <div>
                    <dt class="font-heading text-xs uppercase tracking-[0.14em] text-gold font-semibold">{label}</dt>
                    <dd class="mt-1 text-navy/85 leading-snug">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </details>
    </div>
  </section>

  <section id="photos" class="bg-white px-4 sm:px-6 lg:px-8 py-10 md:py-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-6">
        <div>
          <h2 class="font-display text-3xl text-navy">Listing photos</h2>
          <p class="text-navy/60 text-sm mt-1">{total} photos from the public MLS #{listing.mls} set. Tap any photo to open it, then swipe or use the arrows.</p>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3">
        {photos.map(([file, w, h], i) => (
          <a href={`${base}/photos/${file}`} data-full={`${base}/photos/${file}`} data-alt={`${listing.title} listing photo ${i + 1} of ${total}`} data-lightbox={listing.mls} class="block overflow-hidden rounded bg-cream aspect-[4/3]">
            <img src={`${base}/photos/${file}`} width={w} height={h} alt={`Listing photo ${i + 1} of ${total}`} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="next" class="px-4 sm:px-6 lg:px-8 py-10 md:py-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <h2 class="font-display text-3xl text-navy mb-4">Next steps</h2>
        <ol class="space-y-4">
          {listing.steps.map((item, i) => (
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-navy text-gold font-heading flex items-center justify-center">{i + 1}</span>
              <p class="text-navy/85 leading-relaxed pt-1">{item}</p>
            </li>
          ))}
        </ol>
        <p class="mt-8">
          <a href={`${portfolioBase}/`} class="text-navy font-semibold underline decoration-gold decoration-2 underline-offset-4 hover:text-gold">Back to properties for Debbie Hennessy</a>
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl text-navy mb-3">Sources</h2>
        <ul class="space-y-2">
          {listing.sources.map((source) => (
            <li>
              <a href={source.href} class="text-navy underline decoration-gold decoration-2 underline-offset-4 hover:text-gold break-words" target="_blank" rel="noopener noreferrer">{source.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="px-4 sm:px-6 lg:px-8 pb-10">
    <div class="max-w-6xl mx-auto text-xs text-navy/60 leading-relaxed space-y-2">
      <p>Listing photos and listing data: UtahRealEstate.com, MLS #{listing.mls}. Copyright © UtahRealEstate.com. All rights reserved. Watermarks on the photos are the source marks.</p>
      {listing.notes.map((note) => <p>{note}</p>)}
      <p>Acreage, water, septic, access, and zoning are subject to the documents.</p>
      <p>Listing courtesy of {listing.brokerage}.</p>
    </div>
  </section>
  <PhotoLightbox />
</BaseLayout>
