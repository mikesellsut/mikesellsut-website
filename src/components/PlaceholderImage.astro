---
interface Props {
  label: string;
  width?: number;
  height?: number;
  class?: string;
}

const { label, width = 600, height = 600, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "bg-navy/10 border-2 border-dashed border-navy/30 rounded-lg flex items-center justify-center text-center p-6",
    className,
  ]}
  style={`aspect-ratio: ${width} / ${height}; max-width: ${width}px;`}
  role="img"
  aria-label={label}
>
  <div>
    <svg
      class="w-12 h-12 mx-auto mb-3 text-navy/30"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
      />
    </svg>
    <p class="text-sm text-navy/50 font-body leading-snug max-w-[200px] mx-auto">
      {label}
    </p>
  </div>
</div>
