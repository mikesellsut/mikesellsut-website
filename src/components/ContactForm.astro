---
interface Props {
  heading?: string;
  subheading?: string;
  showDropdown?: boolean;
}

const {
  heading = "Ready to Make Your Move?",
  subheading,
  showDropdown = true,
} = Astro.props;
---

<section class="bg-cream/50 border border-gold/30 rounded-lg p-6 sm:p-8 lg:p-10 shadow-sm">
  {heading && (
    <h2 class="font-heading text-2xl sm:text-3xl text-navy uppercase tracking-wide text-center mb-2">
      {heading}
    </h2>
  )}
  {subheading && (
    <p class="font-body text-navy/70 text-center mb-6 max-w-lg mx-auto">
      {subheading}
    </p>
  )}
  {!subheading && heading && <div class="mb-6" />}

  <form
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="space-y-4 max-w-xl mx-auto"
  >
    <!-- Honeypot -->
    <p class="hidden">
      <label>
        Don't fill this out: <input name="bot-field" />
      </label>
    </p>
    <input type="hidden" name="form-name" value="contact" />

    <!-- Name -->
    <div>
      <label for="contact-name" class="block text-sm font-semibold text-navy mb-1">
        Name <span class="text-red">*</span>
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        class="w-full px-4 py-3 bg-cream border border-navy/20 rounded-md text-navy placeholder-navy/40 focus:outline-none focus:ring-2 focus:ring-gold focus:border-gold transition-colors"
        placeholder="Your full name"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="contact-email" class="block text-sm font-semibold text-navy mb-1">
        Email <span class="text-red">*</span>
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        class="w-full px-4 py-3 bg-cream border border-navy/20 rounded-md text-navy placeholder-navy/40 focus:outline-none focus:ring-2 focus:ring-gold focus:border-gold transition-colors"
        placeholder="you@email.com"
      />
    </div>

    <!-- Phone -->
    <div>
      <label for="contact-phone" class="block text-sm font-semibold text-navy mb-1">
        Phone
      </label>
      <input
        type="tel"
        id="contact-phone"
        name="phone"
        class="w-full px-4 py-3 bg-cream border border-navy/20 rounded-md text-navy placeholder-navy/40 focus:outline-none focus:ring-2 focus:ring-gold focus:border-gold transition-colors"
        placeholder="(435) 555-0123"
      />
    </div>

    <!-- Dropdown -->
    {showDropdown && (
      <div>
        <label for="contact-interest" class="block text-sm font-semibold text-navy mb-1">
          I'm interested in...
        </label>
        <select
          id="contact-interest"
          name="interest"
          class="w-full px-4 py-3 bg-cream border border-navy/20 rounded-md text-navy focus:outline-none focus:ring-2 focus:ring-gold focus:border-gold transition-colors"
        >
          <option value="">Select an option</option>
          <option value="buying">Buying</option>
          <option value="selling">Selling</option>
          <option value="both">Both</option>
          <option value="just-looking">Just Looking</option>
          <option value="other">Other</option>
        </select>
      </div>
    )}

    <!-- Message -->
    <div>
      <label for="contact-message" class="block text-sm font-semibold text-navy mb-1">
        Message
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        class="w-full px-4 py-3 bg-cream border border-navy/20 rounded-md text-navy placeholder-navy/40 focus:outline-none focus:ring-2 focus:ring-gold focus:border-gold transition-colors resize-y"
        placeholder="Tell me about what you're looking for..."
      ></textarea>
    </div>

    <!-- Submit -->
    <div class="pt-2">
      <button
        type="submit"
        class="w-full sm:w-auto px-8 py-3 bg-gold text-white font-heading uppercase tracking-wider text-sm rounded-md hover:brightness-110 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-md"
      >
        Send Message
      </button>
    </div>
  </form>
</section>
