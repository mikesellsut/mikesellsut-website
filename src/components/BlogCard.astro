---
interface Props {
  title: string;
  excerpt: string;
  date: Date;
  slug: string;
  image?: string;
  category?: string;
  class?: string;
}

const { title, excerpt, date, slug, image, category, class: className = "" } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a
  href={`/blog/${slug}`}
  class:list={[
    "group block bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1",
    className,
  ]}
>
  {image ? (
    <div class="relative h-44 overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="h-44 bg-gradient-to-br from-navy to-sky flex items-center justify-center">
      <svg class="w-12 h-12 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
      </svg>
    </div>
  )}
  <div class="p-5">
    {category && (
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-sky mb-2">
        {category}
      </span>
    )}
    <h3 class="font-heading text-lg font-bold text-navy group-hover:text-sky transition-colors leading-tight">
      {title}
    </h3>
    <p class="text-sm text-navy/70 mt-2 leading-relaxed line-clamp-2">{excerpt}</p>
    <time class="block text-xs text-navy/50 mt-3" datetime={date.toISOString()}>
      {formattedDate}
    </time>
  </div>
</a>
