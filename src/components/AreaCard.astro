---
interface Props {
  name: string;
  image: string;
  description: string;
  href: string;
  class?: string;
}

const { name, image, description, href, class: className = "" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group block bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1",
    className,
  ]}
>
  <div class="relative h-48 overflow-hidden">
    <img
      src={image}
      alt={name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
    <h3 class="absolute bottom-3 left-4 font-heading text-xl font-bold text-white uppercase tracking-wide">
      {name}
    </h3>
  </div>
  <div class="p-5">
    <p class="text-sm text-navy/80 leading-relaxed">{description}</p>
    <span class="inline-flex items-center gap-1 mt-3 text-gold font-semibold text-sm group-hover:gap-2 transition-all">
      Explore Area
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
