---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import AreaCard from "../components/AreaCard.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog"))
  .filter((p) => p.data.published && new Date(p.data.date) <= new Date())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const areas = [
  {
    name: "Sanpete County",
    image: "/images/areas/sanpete-county-sign.jpg",
    description: "Historic towns, stunning valleys, and a tight-knit community feel that makes Sanpete one of Utah's most charming places to call home.",
    href: "/areas#sanpete",
  },
  {
    name: "Sevier County",
    image: "/images/areas/sevier-river.jpg",
    description: "A gateway to outdoor adventure with a growing economy, affordable living, and breathtaking mountain scenery in every direction.",
    href: "/areas#sevier",
  },
  {
    name: "Millard County",
    image: "/images/areas/millard-meadow-hotsprings.jpg",
    description: "Wide-open spaces, rich agricultural heritage, and hidden gems like Meadow Hot Springs make Millard a land of opportunity.",
    href: "/areas#millard",
  },
  {
    name: "Juab County",
    image: "/images/areas/juab-mt-nebo.jpg",
    description: "From the towering peak of Mt. Nebo to the welcoming town of Nephi, Juab County offers rural charm with easy access to the Wasatch Front.",
    href: "/areas#juab",
  },
];
---

<BaseLayout
  title="Home"
  description="Mike Price is a Central Utah REALTOR® with Heritage Realty Group, serving Sanpete, Sevier, Millard & Juab Counties. 20 years of local market expertise."
>

  <!-- ===== HERO SECTION ===== -->
  <section class="relative min-h-[600px] md:min-h-[700px] flex items-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0">
      <img
        src="/images/site/hero-horseshoe-mountain.jpg"
        alt="Horseshoe Mountain panoramic landscape in Central Utah"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-navy/60"></div>
    </div>

    <!-- Biplane decoration -->
    <div class="absolute top-12 right-8 md:top-16 md:right-16 opacity-30 md:opacity-40 pointer-events-none" id="hero-biplane">
      <img src="/images/site/biplane.png" alt="" class="w-24 md:w-40 lg:w-52" aria-hidden="true" />
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center md:text-left">
      <div class="max-w-3xl">
        <h1 class="hero-heading font-display italic text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white leading-[1.1] lg:leading-[1.05] tracking-tight mb-4" style="opacity:0;">
          Helping You Land the Perfect Property
        </h1>
        <p class="hero-sub font-body text-lg sm:text-xl md:text-2xl text-white/90 mb-8 max-w-2xl" style="opacity:0;">
          Central Utah Real Estate — Sanpete, Sevier, Millard &amp; Juab Counties
        </p>
        <div class="hero-ctas flex flex-col sm:flex-row gap-4 justify-center md:justify-start" style="opacity:0;">
          <a
            href="/listings"
            class="inline-block px-8 py-4 bg-gold text-white font-heading uppercase tracking-wider text-lg rounded-md hover:brightness-110 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-lg text-center"
          >
            Start Your Search
          </a>
          <a
            href="/contact"
            class="inline-block px-8 py-4 bg-transparent border-2 border-white text-white font-heading uppercase tracking-wider text-lg rounded-md hover:bg-white hover:text-navy transition-all duration-200 text-center"
          >
            Contact Mike
          </a>
        </div>
        <!-- Seller CTAs -->
        <div class="hero-seller-ctas flex flex-col sm:flex-row gap-3 justify-center md:justify-start mt-3" style="opacity:0;">
          <a
            href="/contact"
            class="inline-block px-6 py-3 bg-white/10 border border-white/50 text-white font-heading uppercase tracking-wider text-sm rounded-md hover:bg-white/20 transition-all duration-200 text-center"
          >
            What's My Home Worth?
          </a>
          <a
            href="/contact"
            class="inline-block px-6 py-3 bg-white/10 border border-white/50 text-white font-heading uppercase tracking-wider text-sm rounded-md hover:bg-white/20 transition-all duration-200 text-center"
          >
            Talk to Mike About Selling
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom gradient fade -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-cream to-transparent"></div>
  </section>

  <!-- ===== ABOUT PREVIEW ===== -->
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Headshot -->
        <div class="flex justify-center md:justify-end">
          <img
            src="/images/site/mike-headshot.jpg"
            alt="Mike Price, REALTOR® with Heritage Realty Group LLC"
            class="w-full max-w-md rounded-lg"
          />
        </div>

        <!-- Text -->
        <div>
          <h2 class="font-heading text-3xl md:text-4xl text-navy uppercase tracking-wide mb-4">
            Meet Mike Price
          </h2>
          <div class="w-16 h-1 bg-gold mb-6"></div>
          <p class="font-body text-lg text-navy/80 leading-relaxed mb-4">
            With 20 years of hands-on real estate market expertise across Central Utah, I bring a deep understanding of property values, pricing trends, and neighborhood dynamics to every transaction.
          </p>
          <p class="font-body text-navy/80 leading-relaxed mb-6">
            Whether you're buying your first home, selling a family property, or searching for the perfect piece of land, I'm here to guide you with honest advice and local knowledge you won't find anywhere else.
          </p>
          <a
            href="/about"
            class="inline-flex items-center gap-2 text-gold font-semibold hover:gap-3 transition-all duration-200"
          >
            Learn More About Mike
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== VINTAGE DIVIDER ===== -->
  <div class="vintage-divider max-w-4xl mx-auto">
    <span class="vintage-divider-dot"></span>
  </div>

  <!-- ===== AREAS I SERVE ===== -->
  <section class="py-12 lg:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12 max-w-2xl" data-animate>
        <h2 class="font-heading text-3xl md:text-4xl text-navy uppercase tracking-wide mb-4">
          Areas I Serve
        </h2>
        <div class="w-16 h-1 bg-gold mb-4"></div>
        <p class="font-body text-navy/70 text-lg mb-4">
          My primary focus is Central Utah, where I have deep experience with the communities, properties, and local market conditions. I am also well-versed in real estate markets throughout much of Utah and am open to working with buyers and sellers beyond my primary area when the property and circumstances are a good fit.
        </p>
        <p class="font-body text-navy/70 text-lg">
          If you are considering buying or selling anywhere in the state, feel free to reach out and let's discuss how I can help.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-animate-stagger>
        {areas.map((area) => (
          <AreaCard
            name={area.name}
            image={area.image}
            description={area.description}
            href={area.href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LATEST FROM THE BLOG ===== -->
  {allPosts.length > 0 && (
    <section class="py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="mb-12 max-w-2xl" data-animate>
          <h2 class="font-heading text-3xl md:text-4xl text-navy uppercase tracking-wide mb-4">
            Latest From the Blog
          </h2>
          <div class="w-16 h-1 bg-gold mb-4"></div>
          <p class="font-body text-navy/70 text-lg">
            Market updates, buyer tips, and local insights from Central Utah.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {allPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              date={post.data.date}
              slug={post.slug}
              image={post.data.featured_image}
              category={post.data.category}
            />
          ))}
        </div>
        <div class="text-right mt-10" data-animate>
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-gold font-semibold text-lg hover:gap-3 transition-all duration-200"
          >
            View All Posts
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}


  <!-- ===== FREQUENTLY ASKED QUESTIONS ===== -->
  <section class="py-20 lg:py-28 px-4 sm:px-6 lg:px-8 bg-cream">
    <div class="max-w-3xl mx-auto" data-animate>
      <h2 class="font-heading text-3xl md:text-4xl text-navy uppercase tracking-wide mb-4">
        Common Questions
      </h2>
      <div class="w-16 h-1 bg-gold mb-10"></div>

      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How do I choose a REALTOR in Central Utah?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Look for someone who actually knows the market you're buying or selling in — not just a license and a sign. In a rural area like Central Utah, local knowledge matters more than volume. You want an agent who has walked properties like yours, understands the land-use quirks, and can read comps that may be months old or in different towns. Ask how many transactions they've done in your county specifically, and how they arrive at a price."
            }
          },
          {
            "@type": "Question",
            "name": "What does it cost to sell a home in Central Utah?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Typical seller costs include agent commission, title insurance, and closing fees. The exact numbers depend on your sale price and what gets negotiated. I put together a net proceeds estimate before we list so you know what you'll walk away with — no surprises at the closing table."
            }
          },
          {
            "@type": "Question",
            "name": "How long does it take to sell a home in this market?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Well-priced homes in good condition are typically selling within 30 to 90 days in Central Utah. Land and rural properties can take longer because the buyer pool is narrower. Overpriced properties sit — and once a listing goes stale, it's hard to recover. Getting the price right from day one is the single biggest factor in how fast you sell."
            }
          },
          {
            "@type": "Question",
            "name": "What's different about buying or selling land and cabins versus a regular house?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A lot. With land, you're evaluating access, water, zoning, perc tests, mineral rights, and how far you are from utilities — none of which show up in a square footage calculation. Cabins often have limited comparables, seasonal access issues, and financing quirks that standard lenders aren't set up for. These transactions reward an agent who has done enough of them to know what to look for and what questions to ask."
            }
          },
          {
            "@type": "Question",
            "name": "Why does it matter that you're also a licensed appraiser?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Most agents estimate price based on what similar homes sold for. That's a start, but in a rural market with thin sales data, you have to understand what's actually driving value — lot size, water rights, outbuildings, access, condition, location. As a certified residential appraiser with 20 years in this market, I approach pricing the way an appraiser does: methodically, with real support for every number. That means fewer surprises for buyers at appraisal, and more defensible prices for sellers."
            }
          },
          {
            "@type": "Question",
            "name": "Do you work with buyers or just sellers?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Both. I work with buyers looking for homes, land, cabins, and rural property across Sanpete, Sevier, Millard, and Juab Counties. For buyers, the appraiser background helps you avoid overpaying — I can tell you when a price is supported by the market and when it isn't."
            }
          }
        ]
      })} />

      <div class="space-y-0 divide-y divide-navy/10">
        {[
          {
            q: "How do I choose a REALTOR in Central Utah?",
            a: "Look for someone who actually knows the market you're buying or selling in — not just a license and a sign. In a rural area like Central Utah, local knowledge matters more than volume. Ask how many transactions they've done in your county specifically, and how they arrive at a price."
          },
          {
            q: "What does it cost to sell a home in Central Utah?",
            a: "Typical seller costs include agent commission, title insurance, and closing fees. I put together a net proceeds estimate before we list so you know what you'll walk away with — no surprises at the closing table."
          },
          {
            q: "How long does it take to sell a home in this market?",
            a: "Well-priced homes in good condition are typically selling within 30 to 90 days. Land and rural properties can take longer — the buyer pool is narrower. Overpriced properties sit, and once a listing goes stale, it's hard to recover. Getting the price right from day one is the single biggest factor."
          },
          {
            q: "What's different about buying or selling land and cabins versus a regular house?",
            a: "A lot. With land, you're evaluating access, water, zoning, perc tests, mineral rights, and proximity to utilities — none of which show up in a square footage calculation. Cabins often have limited comparables, seasonal access, and financing quirks that standard lenders aren't set up for. These transactions reward experience."
          },
          {
            q: "Why does it matter that you're also a licensed appraiser?",
            a: "Most agents estimate price based on recent sales. That's a start, but in a rural market with thin data, you have to understand what's actually driving value — water rights, outbuildings, access, condition. As a certified residential appraiser with 20 years in this market, I approach pricing methodically and with real support for every number. Fewer surprises at appraisal for buyers, more defensible prices for sellers."
          },
          {
            q: "Do you work with buyers or just sellers?",
            a: "Both. I work with buyers looking for homes, land, cabins, and rural property across Sanpete, Sevier, Millard, and Juab Counties. The appraiser background helps you avoid overpaying — I can tell you when a price is supported by the market and when it isn't."
          }
        ].map(({ q, a }) => (
          <details class="group py-5 cursor-pointer">
            <summary class="flex justify-between items-start gap-4 font-heading text-navy font-semibold text-lg list-none">
              <span>{q}</span>
              <svg class="w-5 h-5 mt-1 shrink-0 text-gold transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-3 font-body text-navy/70 leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LEAD CAPTURE ===== -->
  <section class="py-20 lg:py-32 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-3xl mx-auto" data-animate>
      <ContactForm
        heading="Ready to Make Your Move?"
        subheading="Whether you're buying, selling, or just exploring your options — I'd love to hear from you."
      />
    </div>
  </section>

  <!-- Hero animation script -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    // Hero fade-in sequence
    const tl = gsap.timeline({ defaults: { ease: "power2.out" } });
    tl.to(".hero-heading", { opacity: 1, y: 0, duration: 0.8 }, 0.2)
      .from(".hero-heading", { y: 40 }, 0.2)
      .to(".hero-sub", { opacity: 1, y: 0, duration: 0.8 }, 0.5)
      .from(".hero-sub", { y: 30 }, 0.5)
      .to(".hero-ctas", { opacity: 1, y: 0, duration: 0.8 }, 0.8)
      .from(".hero-ctas", { y: 20 }, 0.8)
      .to(".hero-seller-ctas", { opacity: 1, y: 0, duration: 0.7 }, 1.0)
      .from(".hero-seller-ctas", { y: 15 }, 1.0);

    // Biplane gentle drift — the artwork noses to the right, so flip it
    // horizontally whenever it heads left, otherwise it flies backwards.
    ScrollTrigger.matchMedia({
      "(min-width: 768px)": function () {
        const biplane = document.querySelector("#hero-biplane img");
        const tl = gsap.timeline({ repeat: -1 });
        tl.set(biplane, { scaleX: 1 })
          .to("#hero-biplane", { x: 80, y: -8, duration: 6, ease: "sine.inOut" })
          .set(biplane, { scaleX: -1 })
          .to("#hero-biplane", { x: 0, y: 15, duration: 6, ease: "sine.inOut" });
      },
    });
  </script>
</BaseLayout>
