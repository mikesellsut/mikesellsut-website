---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const areas = await getCollection("areas");
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const { Content } = await area.render();

// Other counties, for cross-linking (helps both users and AI crawlers understand the full territory)
const allAreas = await getCollection("areas");
const others = allAreas.filter((a) => a.slug !== area.slug);
---

<BaseLayout
  title={`${area.data.area_name} Real Estate`}
  description={area.data.description}
  image={area.data.photo}
>
  <!-- Hero -->
  <section class="bg-navy py-16 md:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center">
      <h1 class="font-heading text-4xl md:text-5xl text-white uppercase tracking-wide mb-4">
        {area.data.area_name} Real Estate
      </h1>
      <p class="font-body text-lg md:text-xl text-white/80 max-w-3xl mx-auto">
        {area.data.description}
      </p>
      {area.data.towns?.length > 0 && (
        <p class="font-body text-sm text-gold uppercase tracking-wider mt-6">
          Serving {area.data.towns.join(", ")}
        </p>
      )}
    </div>
  </section>

  {area.data.photo && (
    <div class="w-full h-64 md:h-96 overflow-hidden">
      <img
        src={area.data.photo}
        alt={`${area.data.area_name}, Utah`}
        class="w-full h-full object-cover"
      />
    </div>
  )}

  <!-- Full Guide Content -->
  <article class="py-12 lg:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      {area.data.market_highlights && (
        <div class="mb-10 p-6 bg-white border-2 border-gold/40 rounded-lg">
          <p class="font-heading text-sm uppercase tracking-wider text-gold mb-2">
            Market Snapshot
          </p>
          <p class="font-body text-navy/80 leading-relaxed">{area.data.market_highlights}</p>
        </div>
      )}

      <div class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:uppercase prose-headings:tracking-wide prose-headings:text-navy prose-p:text-navy/80 prose-p:leading-relaxed prose-a:text-gold prose-a:no-underline hover:prose-a:underline prose-strong:text-navy prose-li:text-navy/80">
        <Content />
      </div>
    </div>
  </article>

  <!-- Cross-links to other counties -->
  {others.length > 0 && (
    <section class="py-12 lg:py-16 px-4 sm:px-6 lg:px-8 bg-white">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-heading text-2xl text-navy uppercase tracking-wide text-center mb-8">
          Explore the Other Counties I Serve
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {others.map((o) => (
            <a
              href={`/areas/${o.slug}`}
              class="block p-6 bg-cream rounded-lg border-2 border-navy/10 hover:border-gold transition-colors text-center"
            >
              <span class="font-heading text-lg text-navy uppercase tracking-wide">
                {o.data.area_name}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-12 lg:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto" data-animate>
      <ContactForm
        heading={`Ready to Explore ${area.data.area_name}?`}
        subheading="Reach out and let's talk about what's available and what fits your search."
      />
    </div>
  </section>
</BaseLayout>
