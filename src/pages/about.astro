---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
const values = [
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`,
    title: "Market Knowledge Built Through Experience",
    desc: "With more than 20 years of real estate experience, I bring a depth of market knowledge that few agents can offer. As both a certified real estate appraiser and a Realtor, I spend my career studying properties, analyzing market activity, and understanding what truly influences value throughout Central Utah.\n\nWhen I recommend a price for a property, I'm not guessing. My advice is grounded in real data, local market knowledge, and decades of hands-on experience.\n\nOver the years, I have also become a trusted resource for local real estate professionals who turn to me when they are dealing with a difficult property or a pricing question that does not have an obvious answer. That trust means a great deal to me, and I bring the same level of care, analysis, and honesty to every client I represent.",
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    title: "Straight Talk, No Games",
    desc: "I'll always give you my honest assessment of a property, a price, or a situation—even when it may not be what you were hoping to hear.\n\nThe decision is always yours. My job is to make sure you understand the market, the risks, and the available options so you can make the right decision for your circumstances.\n\nMy goal is not simply to close a deal. It is to help you make a move that makes sense for your situation.",
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>`,
    title: "A Clear and Transparent Process",
    desc: "Real estate can feel complicated when no one takes the time to explain what is happening.\n\nI'll make sure you understand what to expect, what decisions need to be made, and what comes next—from representation and pricing through negotiations, inspections, appraisal, and closing.\n\nYou will not be left guessing about the process or where you stand.",
  },
];

// Person schema — establishes Mike specifically (not just the business)
// as a credentialed, real individual for search/AI authority signals.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mike Price",
  jobTitle: "REALTOR®",
  image: "https://mikesellsut.com/images/site/mike-headshot.jpg",
  url: "https://mikesellsut.com/about",
  telephone: "+14356600401",
  email: "mikesellsut@gmail.com",
  worksFor: {
    "@type": "Organization",
    name: "Heritage Realty Group LLC",
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Sanpete County, UT" },
    { "@type": "AdministrativeArea", name: "Sevier County, UT" },
    { "@type": "AdministrativeArea", name: "Millard County, UT" },
    { "@type": "AdministrativeArea", name: "Juab County, UT" },
  ],
  knowsAbout: [
    "Residential real estate",
    "Land and rural property",
    "Cabin and mountain properties",
    "Manufactured and modular homes",
    "Conventional financing",
    "FHA financing",
    "USDA Rural Development loans",
  ],
  sameAs: [
    "https://www.instagram.com/mikesellsut",
    "https://www.facebook.com/profile.php?id=61577587227657",
  ],
};
---

<BaseLayout
  title="About"
  description="Learn about Mike Price, a Central Utah REALTOR® with Heritage Realty Group and 20 years of market expertise across Sanpete, Sevier, Millard & Juab Counties."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <!-- Hero Banner -->
  <section class="bg-navy py-16 md:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="font-heading text-4xl md:text-5xl text-white uppercase tracking-wide mb-4">
        About Mike
      </h1>
      <p class="font-display italic text-xl md:text-2xl text-gold">
        Your Trusted Central Utah REALTOR&reg;
      </p>
    </div>
  </section>
  <div class="h-1 bg-gold"></div>

  <!-- Bio Section -->
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div class="flex justify-center">
          <img
            src="/images/site/mike-headshot.jpg"
            alt="Mike Price, REALTOR® with Heritage Realty Group LLC"
            class="w-full max-w-md rounded-lg sticky top-24"
          />
        </div>

        <div class="space-y-5">
          <h2 class="font-heading text-3xl text-navy uppercase tracking-wide">My Story</h2>
          <div class="w-16 h-1 bg-gold"></div>

          <p class="font-body text-lg text-navy/80 leading-relaxed">
            I'm Mike Price—a REALTOR&reg; with Heritage Realty Group LLC, serving Central Utah, with over two decades of real estate experience in this region.
          </p>

          <p class="font-body text-navy/80 leading-relaxed">
            What sets me apart from most agents is that I'm also a certified real estate appraiser, which means I've spent my career understanding property value from multiple sides of the transaction. I know how to analyze what a property is likely to bring in the market and how to price it to perform.
          </p>

          <p class="font-body text-navy/80 leading-relaxed">
            My wife and I have deep family roots in both Juab and Sanpete counties. This isn't just where I work. It's home, and it's a place we're proud to be part of.
          </p>

          <p class="font-body text-navy/80 leading-relaxed">
            I serve Sanpete, Sevier, Millard, and Juab counties, specializing in residential homes, land, cabins, rural properties, and mountain homes. I work best with buyers and sellers who value a direct, no-nonsense approach—people who want honest answers, not a sales pitch.
          </p>

          <p class="font-body text-navy/80 leading-relaxed">
            Integrity is above everything for me. If being straight with someone kills a deal, then that's a deal I don't want to be part of.
          </p>

          <p class="font-body text-navy/80 leading-relaxed">
            I meet with clients in person, and I walk every property I list before I ever recommend a price. I need to understand the full picture—the property, the condition, the location, and the details that may affect how it competes in the market. That's not extra effort. That's simply how the job should be done.
          </p>

          <p class="font-body text-navy/80 leading-relaxed">
            If you're selling, here's something worth knowing: a fast sale isn't always a good sale. Selling quickly can be a great result, but speed by itself does not mean the property was priced correctly or that the seller received the best outcome. I understand market exposure and what a reasonable amount of time on the market should look like. I'm not going to underprice your property to make my job easier.
          </p>

          <p class="font-body text-navy/80 leading-relaxed font-semibold">
            Let's talk. Call me at <a href="tel:4356600401" class="text-gold hover:underline">435-660-0401</a> or <a href="/contact" class="text-gold hover:underline">send me a message</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Work With Mike -->
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12" data-animate>
        <h2 class="font-heading text-3xl md:text-4xl text-navy uppercase tracking-wide mb-4">
          Why Work With Mike
        </h2>
        <div class="w-16 h-1 bg-gold mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-animate-stagger>
        {values.map((v) => (
          <div class="text-center p-8 bg-cream rounded-lg border border-navy/5">
            <div class="text-gold mb-4 flex justify-center" set:html={v.icon} />
            <h3 class="font-heading text-lg text-navy uppercase tracking-wide mb-4">{v.title}</h3>
            <div class="font-body text-sm text-navy/70 leading-relaxed whitespace-pre-line">{v.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 lg:px-8" data-animate>
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl text-navy uppercase tracking-wide mb-8">
        Credentials
      </h2>
      <div class="bg-white rounded-lg p-8 shadow-sm border border-navy/5 space-y-3 text-navy/80">
        <p><span class="font-semibold text-navy">Licensed REALTOR&reg;</span> — State of Utah</p>
        <p>Agent License: 5957476-LA00</p>
        <p>Heritage Realty Group LLC — Broker: Lawny R. Hunt</p>
        <p>Office License: 6232680</p>
        <p>149 East 300 North, Spring City, UT 84662</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-3xl mx-auto" data-animate>
      <ContactForm
        heading="Let's Work Together"
        subheading="Ready to start your real estate journey? Reach out and let's chat — no pressure, just honest conversation."
      />
    </div>
  </section>
</BaseLayout>
