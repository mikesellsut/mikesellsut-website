---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { listings, type ListingStatus } from "../data/listings";

// Listing photos live in src/assets/listings/ so Astro can optimize them.
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/listings/*.{jpg,jpeg,png,webp}",
  { eager: true }
);
const photoByFile = (file: string): ImageMetadata => {
  const mod = photoModules[`../assets/listings/${file}`];
  if (!mod) throw new Error(`Listing photo not found: src/assets/listings/${file}`);
  return mod.default;
};

const priceFormatter = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});

const formatAcres = (acres: number) =>
  `${acres.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} acres`;

const statusClass: Record<ListingStatus, string> = {
  Active: "bg-gold text-white",
  "Under Contract": "bg-red text-white",
  Sold: "bg-navy text-white",
};

const cards = listings.map((listing) => ({
  ...listing,
  priceText: priceFormatter.format(listing.price),
  facts: [
    listing.beds != null ? `${listing.beds} bd` : null,
    listing.baths != null ? `${listing.baths} ba` : null,
    listing.acres != null ? formatAcres(listing.acres) : null,
  ].filter((f): f is string => f !== null),
  location: listing.subdivision ? `${listing.subdivision} · ${listing.town}, UT` : `${listing.town}, UT`,
  images: listing.photos.map((p) => ({ ...p, src: photoByFile(p.file) })),
}));

const otherSearchCards = [
  {
    title: "Heritage Realty Group Listings",
    description: "See all current properties listed by Mike Price and Heritage Realty Group on the Utah MLS.",
    href: "https://www.utahrealestate.com/roster/office.listings.report/id/68862",
    cta: "View Office Listings",
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>`,
  },
  {
    title: "Search All Utah Listings",
    description: "Browse the full Utah MLS database — every property currently on the market across the state.",
    href: "https://www.utahrealestate.com",
    cta: "Search Now",
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>`,
  },
  {
    title: "Can't Find What You're Looking For?",
    description: "I have access to listings before they hit the public market. Tell me what you need and I'll do a personalized search.",
    href: "/contact",
    cta: "Contact Mike",
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
  },
];

const pageTitle = "Current Listings";
const pageDescription =
  "Mike Price's current listings in Central Utah — cabins, land, and rural property with photos, prices, and acreage — plus links to search the Utah MLS.";

// Describes the page itself. The authoritative listing records live on
// Utah's MLS (utahrealestate.com), so no RealEstateListing markup here.
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${pageTitle} | Mike Price, REALTOR® — Central Utah Real Estate`,
  description: pageDescription,
  url: "https://mikesellsut.com/listings",
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <section class="bg-navy py-16 md:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="font-heading text-4xl md:text-5xl text-white uppercase tracking-wide mb-4">
        Current Listings
      </h1>
      <p class="font-body text-lg text-white/80 max-w-2xl mx-auto">
        Cabins, land, and rural property I currently have listed in Central Utah. Questions or want to see one in person? Reach out anytime.
      </p>
    </div>
  </section>
  <div class="h-1 bg-gold"></div>

  <!-- ===== CURRENT LISTINGS ===== -->
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      {cards.length === 0 ? (
        <div class="bg-white rounded-lg p-10 text-center shadow-md border border-navy/5" data-animate>
          <p class="font-body text-navy/80 text-lg leading-relaxed max-w-2xl mx-auto">
            No active listings right now — new properties are coming soon. Contact me and I'll let you know as soon as something fits what you're looking for.
          </p>
          <a
            href="/contact"
            class="inline-block mt-6 px-8 py-3 bg-gold text-white font-heading uppercase tracking-wider text-sm rounded-md hover:brightness-110 transition-all duration-200 shadow-md"
          >
            Contact Mike
          </a>
        </div>
      ) : (
        <div class="space-y-12">
          {cards.map((card, cardIndex) => (
            <article
              id={card.id}
              class="listing-card bg-white rounded-lg overflow-hidden shadow-md border border-navy/5 grid grid-cols-1 lg:grid-cols-12"
            >
              <!-- Photos -->
              <div class="lg:col-span-7">
                <div class="relative aspect-[16/10] overflow-hidden bg-navy/5">
                  <Image
                    src={card.images[0].src}
                    alt={card.images[0].alt}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 640px, 100vw"
                    class="w-full h-full object-cover"
                    loading={cardIndex === 0 ? "eager" : "lazy"}
                    fetchpriority={cardIndex === 0 ? "high" : undefined}
                  />
                  <span
                    class:list={[
                      "absolute top-4 left-4 px-3 py-1 rounded-md font-heading uppercase tracking-wider text-xs font-bold shadow-md",
                      statusClass[card.status],
                    ]}
                  >
                    {card.status}
                  </span>
                </div>
                {card.images.length > 1 && (
                  <ul class="grid grid-cols-5 gap-1 p-1 bg-white" aria-label={`More photos: ${card.title}`}>
                    {card.images.slice(1).map((photo) => (
                      <li>
                        <a
                          href={photo.src.src}
                          target="_blank"
                          rel="noopener"
                          class="block aspect-[4/3] overflow-hidden rounded-sm group"
                        >
                          <Image
                            src={photo.src}
                            alt={photo.alt}
                            width={320}
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            loading="lazy"
                          />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <!-- Details -->
              <div class="lg:col-span-5 p-6 md:p-8 flex flex-col">
                <p class="font-heading text-sm text-gold uppercase tracking-wider font-semibold mb-2">
                  {card.type} · {card.town}
                </p>
                <h2 class="font-heading text-2xl text-navy uppercase tracking-wide mb-3">
                  {card.title}
                </h2>
                <p class="font-display text-3xl text-navy mb-3">{card.priceText}</p>
                {card.facts.length > 0 && (
                  <ul class="flex flex-wrap gap-2 mb-3">
                    {card.facts.map((fact) => (
                      <li class="px-3 py-1 bg-cream border border-navy/10 rounded-md font-body text-sm text-navy font-semibold">
                        {fact}
                      </li>
                    ))}
                  </ul>
                )}
                <p class="font-body text-sm text-navy/60 mb-4">{card.location}</p>
                <p class="font-body text-navy/80 leading-relaxed mb-6">{card.blurb}</p>

                <div class="mt-auto">
                  <div class="flex flex-col sm:flex-row gap-3">
                    {card.mlsUrl && (
                      <a
                        href={card.mlsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block px-6 py-3 bg-navy text-white font-heading uppercase tracking-wider text-sm rounded-md hover:bg-sky transition-colors duration-200 text-center"
                      >
                        View on MLS
                      </a>
                    )}
                    <a
                      href="/contact"
                      class="inline-block px-6 py-3 bg-gold text-white font-heading uppercase tracking-wider text-sm rounded-md hover:brightness-110 transition-all duration-200 shadow-md text-center"
                    >
                      Contact Mike
                    </a>
                  </div>
                  <p class="mt-4 font-body text-xs text-navy/50">
                    {card.mlsNumber ? `MLS #${card.mlsNumber} · ` : ""}Listed with Heritage Realty Group
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
      <p class="mt-8 font-body text-xs text-navy/50 text-center">
        Information deemed reliable but not guaranteed. Buyers should verify all details. Contact me at
        <a href="tel:4356600401" class="underline hover:text-gold">435-660-0401</a> or
        <a href="mailto:mikesellsut@gmail.com" class="underline hover:text-gold">mikesellsut@gmail.com</a>.
      </p>
    </div>
  </section>

  <!-- ===== MORE WAYS TO SEARCH ===== -->
  <section class="pb-16 lg:pb-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-heading text-3xl text-navy uppercase tracking-wide mb-4 text-center">
        More Ways to Search
      </h2>
      <div class="w-16 h-1 bg-gold mb-10 mx-auto"></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-animate-stagger>
        {otherSearchCards.map((card) => (
          <a
            href={card.href}
            target={card.href.startsWith("http") ? "_blank" : undefined}
            rel={card.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="group block bg-white rounded-lg p-8 text-center shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-navy/5"
          >
            <div class="text-gold mb-5 flex justify-center" set:html={card.icon} />
            <h3 class="font-heading text-xl text-navy uppercase tracking-wide mb-3">
              {card.title}
            </h3>
            <p class="font-body text-navy/70 text-sm leading-relaxed mb-6">
              {card.description}
            </p>
            <span class="inline-block px-6 py-3 bg-gold text-white font-heading uppercase tracking-wider text-sm rounded-md group-hover:brightness-110 group-hover:scale-[1.02] transition-all duration-200 shadow-md">
              {card.cta}
            </span>
          </a>
        ))}
      </div>

      <div class="mt-16 bg-cream border border-gold/20 rounded-lg p-8 text-center" data-animate>
        <img src="/images/site/biplane.png" alt="" class="w-16 mx-auto mb-4 opacity-30" aria-hidden="true" />
        <p class="font-body text-navy/80 text-lg leading-relaxed max-w-2xl mx-auto">
          New listings hit the market daily. <strong class="text-navy">Contact me for early access</strong> to properties before they're widely advertised. With 20 years of market knowledge, I can help you identify the best opportunities before anyone else sees them.
        </p>
        <a
          href="/contact"
          class="inline-block mt-6 px-8 py-3 bg-navy text-white font-heading uppercase tracking-wider text-sm rounded-md hover:bg-sky transition-colors duration-200"
        >
          Get Early Access
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
