---
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import ContactForm from "../components/ContactForm.astro";
import { getCollection } from "astro:content";

const allTestimonials = (await getCollection("testimonials")).sort(
  (a, b) => {
    const dateA = a.data.date?.valueOf() ?? 0;
    const dateB = b.data.date?.valueOf() ?? 0;
    return dateB - dateA;
  }
);
---

<BaseLayout
  title="Testimonials"
  description="Read what clients say about working with Mike Price, Central Utah REALTOR® with Heritage Realty Group."
>
  <section class="bg-navy py-16 md:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="font-heading text-4xl md:text-5xl text-white uppercase tracking-wide mb-4">
        Testimonials
      </h1>
      <p class="font-body text-lg text-white/80 max-w-2xl mx-auto">
        Don't just take my word for it — hear from the people I've helped buy and sell homes across Central Utah.
      </p>
    </div>
  </section>
  <div class="h-1 bg-gold"></div>

  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      {allTestimonials.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-animate-stagger>
          {allTestimonials.map((t) => (
            <TestimonialCard
              clientName={t.data.client_name}
              quote={t.data.quote}
              date={t.data.date?.toLocaleDateString("en-US", { year: "numeric", month: "long" })}
              featured={t.data.featured}
            />
          ))}
        </div>
      ) : (
        <p class="text-center text-navy/60 py-12 text-lg">
          Testimonials coming soon!
        </p>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-3xl mx-auto" data-animate>
      <ContactForm
        heading="Ready to Be My Next Success Story?"
        subheading="Let's work together to make your real estate goals a reality."
      />
    </div>
  </section>
</BaseLayout>
