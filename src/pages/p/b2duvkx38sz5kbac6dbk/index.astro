const photos: [string, number, number][] = [["01.jpg", 1024, 576], ["02.jpg", 1024, 576], ["03.jpg", 1024, 576], ["04.jpg", 1024, 576], ["05.jpg", 1024, 576], ["06.jpg", 1024, 576], ["07.jpg", 1024, 576], ["08.jpg", 1024, 576], ["09.jpg", 1024, 576], ["10.jpg", 1024, 576], ["11.jpg", 1024, 576], ["12.jpg", 1024, 576], ["13.jpg", 1024, 576], ["14.jpg", 1024, 576], ["15.jpg", 1024, 576], ["16.jpg", 1024, 576], ["17.jpg", 1024, 576], ["18.jpg", 1024, 576], ["19.jpg", 1024, 576], ["20.jpg", 1024, 576], ["21.jpg", 1024, 576], ["22.jpg", 1024, 576], ["23.jpg", 1024, 576], ["24.jpg", 1024, 576], ["25.jpg", 1024, 576], ["26.jpg", 1024, 576], ["27.jpg", 1024, 576], ["28.jpg", 1024, 576], ["29.jpg", 1024, 576], ["30.jpg", 1024, 576], ["31.jpg", 1024, 576], ["32.jpg", 1024, 576], ["33.jpg", 1024, 576], ["34.jpg", 1024, 576], ["35.jpg", 1024, 576], ["36.jpg", 1024, 576], ["37.jpg", 1024, 576], ["38.jpg", 1024, 576], ["39.jpg", 1024, 576], ["40.jpg", 1024, 576], ["41.jpg", 1024, 576], ["42.jpg", 1024, 576], ["43.jpg", 1024, 576], ["44.jpg", 1024, 576], ["45.jpg", 1024, 576], ["46.jpg", 1024, 576], ["47.jpg", 1024, 576], ["48.jpg", 1024, 576], ["49.jpg", 1024, 576], ["50.jpg", 1024, 576], ["51.jpg", 1024, 576], ["52.jpg", 1024, 576], ["53.jpg", 1024, 576], ["54.jpg", 1024, 576], ["55.jpg", 1024, 576], ["56.jpg", 1024, 576], ["57.jpg", 1024, 576], ["58.jpg", 1024, 576], ["59.jpg", 907, 724], ["60.jpg", 921, 731], ["61.jpg", 882, 731], ["62.jpg", 718, 704], ["63.jpg", 855, 736], ["64.jpg", 693, 768]];
