          <img src={`${base}/photos/${file}`} width={w} height={h} alt={`Clements Lane listing photo ${i + 1} of ${total}`} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </section>

  <section id="land" class="px-4 sm:px-6 lg:px-8 py-10 md:py-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4">
      {pillars.map(([title, tone, copy]) => (
        <article class:list={["rounded-lg p-6 shadow-sm", tone]}>
          <h2 class="font-display text-2xl mb-3">{title}</h2>
          <p class:list={["leading-relaxed", title === "Water" ? "text-cream/90" : "text-navy/80"]}>{copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="aerial" class="px-4 sm:px-6 lg:px-8 pb-10 md:pb-14 scroll-mt-32" aria-labelledby="aerial-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="aerial-heading" class="font-display text-3xl text-navy mb-2">Aerial overview</h2>
      <p class="text-navy/70 mb-4 max-w-3xl">Aerial view of 25800 N Clements Ln, Fairview. Location context, not a boundary survey.</p>
      <div class="rounded-lg overflow-hidden border border-navy/10 bg-white h-80 sm:h-96 lg:h-[420px]">
        <iframe
          src={aerialEmbed}
          title="Aerial view of 25800 N Clements Ln, Fairview, Utah. Location context only, not sale boundaries."
          class="w-full h-full"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p class="mt-3">
        <a href={aerialLink} class="text-navy font-semibold underline decoration-gold decoration-2 underline-offset-4 hover:text-gold" target="_blank" rel="noopener noreferrer">Open 25800 N Clements Ln in Google Maps</a>
      </p>
      <p class="mt-1 text-xs text-navy/55">Aerial imagery: Google Maps. Provider credits are on the map.</p>
    </div>
  </section>

  <section id="house" class="px-4 sm:px-6 lg:px-8 pb-10 md:pb-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display text-3xl text-navy mb-2">The house</h2>
      <p class="text-navy/70 mb-6 max-w-3xl">Main floor, upper floor, and a full basement. The basement is unfinished. The county building record is smaller than the listing total. Both numbers are in the specifications.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {improvements.map(([title, copy]) => (
          <div class="bg-white rounded-lg p-4 border border-navy/5">
            <h3 class="font-heading text-xs uppercase tracking-[0.14em] text-gold font-semibold">{title}</h3>
            <p class="mt-2 text-navy/80 leading-relaxed">{copy}</p>
          </div>
        ))}
      </div>
      <details class="mt-4 bg-white rounded-lg border border-navy/5 px-4 py-4 sm:px-6" open>
        <summary class="cursor-pointer font-display text-2xl text-navy">Full listing specifications</summary>
        <p class="mt-2 text-sm text-navy/60">Every public field from the listing, plus the county parcel record.</p>
        <div class="mt-6 space-y-8">
          {specGroups.map((group) => (
            <div>
              <h4 class="font-display text-xl text-navy mb-3 pb-2 border-b-2 border-gold/60">{group.title}</h4>
              <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
                {group.rows.map(([label, value]) => (
                  <div>
                    <dt class="font-heading text-xs uppercase tracking-[0.14em] text-gold font-semibold">{label}</dt>
                    <dd class="mt-1 text-navy/85 leading-snug">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </details>
    </div>
  </section>

  <section id="photos" class="bg-white px-4 sm:px-6 lg:px-8 py-10 md:py-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-6">
        <div>
          <h2 class="font-display text-3xl text-navy">Listing photos</h2>
          <p class="text-navy/60 text-sm mt-1">{total} photos from the public MLS #2184160 set. Tap any photo to open it, then swipe or use the arrows.</p>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3">
        {photos.map(([file, w, h], i) => (
          <a href={`${base}/photos/${file}`} data-full={`${base}/photos/${file}`} data-alt={`Clements Lane listing photo ${i + 1} of ${total}`} data-lightbox="clements" class="block overflow-hidden rounded bg-cream aspect-[4/3]">
            <img src={`${base}/photos/${file}`} width={w} height={h} alt={`Listing photo ${i + 1} of ${total}`} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="next" class="px-4 sm:px-6 lg:px-8 py-10 md:py-14 scroll-mt-32">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <h2 class="font-display text-3xl text-navy mb-4">Next steps</h2>
        <ol class="space-y-4">
          {steps.map((item, i) => (
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-navy text-gold font-heading flex items-center justify-center">{i + 1}</span>
              <p class="text-navy/85 leading-relaxed pt-1">{item}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="font-display text-2xl text-navy mb-3">Sources</h2>
        <ul class="space-y-2">
          {sources.map((source) => (
            <li>
              <a href={source.href} class="text-navy underline decoration-gold decoration-2 underline-offset-4 hover:text-gold break-words" target="_blank" rel="noopener noreferrer">{source.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="px-4 sm:px-6 lg:px-8 pb-10">
    <div class="max-w-6xl mx-auto text-xs text-navy/60 leading-relaxed space-y-2">
      <p>Listing photos and listing data: UtahRealEstate.com, MLS #2184160. Copyright © UtahRealEstate.com. All rights reserved. Watermarks on the photos are the source marks.</p>
      <p>County parcel 00021021X4, serial R030128, is 3.02 acres on the 2025 tax roll. Building area on that roll is 2,196 sq ft, plus a 144 sq ft record. The listing total is 4,490 sq ft, including an unfinished basement.</p>
      <p>Acreage, water shares, the well, septic, access, and zoning are subject to the documents.</p>
      <p>Mike Price, REALTOR&reg; | Heritage Realty Group, LLC | P.O. Box 431, Spring City, UT 84662 | Agent License 5957476-LA00 | Brokerage License 6232680-CN00</p>
      <p>Listing courtesy of Equity Real Estate (Utah).</p>
    </div>
