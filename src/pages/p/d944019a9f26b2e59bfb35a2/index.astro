---
// PRIVATE, LINK-ONLY portfolio. Not linked from the public site, excluded
// from the sitemap (astro.config.mjs filter), noindex/nofollow meta +
// X-Robots-Tag header (netlify.toml "/p/*"). Do not add to nav, llms.txt,
// or any public page.
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import heritageLogo from "../../../assets/heritage-logo.png";
import { listings, photosFor, portfolioBase } from "../../../data/debbiePortfolio";

const price = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});

const cards = listings.map((listing) => {
  const hero = photosFor(listing.mls)[0];
  return {
    listing,
    hero,
    href: `${portfolioBase}/${listing.mls}/`,
    priceText: price.format(listing.price),
    facts: [
      `${listing.beds} bd`,
      `${listing.baths} ba`,
      `${listing.sqft.toLocaleString("en-US")} sq ft`,
      `${listing.acres} acres`,
    ],
  };
});
---

<BaseLayout
  title="Properties Selected for Debbie Hennessy"
  exactTitle={true}
  description="Properties selected for Debbie Hennessy. Active Utah MLS listings with price, acreage, and photos, presented by Mike Price, REALTOR®, Heritage Realty Group."
  image={`${portfolioBase}/${cards[0].listing.mls}/photos/${cards[0].hero[0]}`}
  noindex={true}
>
  <section class="bg-navy py-16 md:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto text-center">
      <p class="font-heading text-xs sm:text-sm uppercase tracking-[0.2em] text-gold mb-3">For Debbie Hennessy</p>
      <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl text-white uppercase tracking-wide mb-4">
        Properties Selected for Debbie Hennessy
      </h1>
      <p class="font-body text-lg text-white/80 max-w-2xl mx-auto">
        Nine listings from the public Utah MLS, with the price, the town, and a short read on each one. Open a property for the photos and the details. If you want to see one, call me.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="tel:4356600401"
          class="inline-block px-6 py-3 bg-gold text-white font-heading uppercase tracking-wider text-sm rounded-md hover:brightness-110 transition-all duration-200 shadow-md"
        >
          Call Mike: 435-660-0401
        </a>
        <a
          href="mailto:mikesellsut@gmail.com?subject=Properties%20for%20Debbie%20Hennessy"
          class="inline-block px-6 py-3 bg-transparent border-2 border-white text-white font-heading uppercase tracking-wider text-sm rounded-md hover:bg-white hover:text-navy transition-all duration-200"
        >
          Email Mike
        </a>
      </div>
    </div>
  </section>
  <div class="h-1 bg-gold"></div>

  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-12">
      {cards.map((card, cardIndex) => (
        <article class="bg-white rounded-lg overflow-hidden shadow-md border border-navy/5 grid grid-cols-1 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <a href={card.href} class="relative block aspect-[16/10] overflow-hidden bg-navy/5">
              <img
                src={`${portfolioBase}/${card.listing.mls}/photos/${card.hero[0]}`}
                width={card.hero[1]}
                height={card.hero[2]}
                alt={`${card.listing.street}, ${card.listing.town}, from the public listing photos`}
                class="w-full h-full object-cover"
                loading={cardIndex === 0 ? "eager" : "lazy"}
                fetchpriority={cardIndex === 0 ? "high" : undefined}
                decoding="async"
              />
              <span
                class:list={[
                  "pointer-events-none absolute top-4 left-4 px-3 py-1 rounded-md font-heading uppercase tracking-wider text-xs font-bold shadow-md",
                  card.listing.statusLabel === "Active" ? "bg-gold text-white" : "bg-navy text-white border-2 border-gold",
                ]}
              >
                {card.listing.statusLabel}
              </span>
            </a>
          </div>
          <div class="lg:col-span-5 p-6 md:p-8 flex flex-col">
            <p class="font-heading text-sm text-gold uppercase tracking-wider font-semibold mb-2">
              {card.listing.kind} · {card.listing.town}
            </p>
            <h2 class="font-heading text-2xl text-navy uppercase tracking-wide mb-3">
              <a href={card.href} class="hover:text-gold">{card.listing.title}</a>
            </h2>
            <p class="font-display text-3xl text-navy mb-3">{card.priceText}</p>
            <ul class="flex flex-wrap gap-2 mb-3">
              {card.facts.map((fact) => (
                <li class="px-3 py-1 bg-cream border border-navy/10 rounded-md font-body text-sm text-navy font-semibold">
                  {fact}
                </li>
              ))}
            </ul>
            <p class="font-body text-sm text-navy/60 mb-4">{card.listing.street}, {card.listing.town}, UT</p>
            <p class="font-body text-navy/80 leading-relaxed mb-6">{card.listing.hook}</p>
            <div class="mt-auto">
              <a
                href={card.href}
                class="inline-block px-6 py-3 bg-navy text-white font-heading uppercase tracking-wider text-sm rounded-md hover:bg-sky transition-colors duration-200 text-center"
              >
                View details
              </a>
              <p class="mt-4 font-body text-xs text-navy/50">MLS #{card.listing.mls}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="px-4 sm:px-6 lg:px-8 pb-16">
    <div class="max-w-6xl mx-auto bg-navy text-white rounded-lg p-6 md:p-8 shadow-md grid grid-cols-1 md:grid-cols-[auto_1fr] gap-6 items-center">
      <img src="/images/site/mike-headshot.jpg" alt="Mike Price, REALTOR®" width="96" height="96" class="w-20 h-20 rounded-full object-cover border-2 border-gold" decoding="async" />
      <div>
        <p class="font-display text-2xl">Mike Price, REALTOR&reg;</p>
        <p class="text-cream/80">Heritage Realty Group, LLC</p>
        <address class="not-italic text-cream/80 text-sm mt-2">P.O. Box 431, Spring City, UT 84662</address>
        <div class="mt-4 flex flex-col sm:flex-row gap-3">
          <a href="tel:4356600401" class="inline-block text-center bg-gold text-navy font-semibold uppercase tracking-wide text-sm px-4 py-3 rounded hover:bg-white">Call or Text 435-660-0401</a>
          <a href="mailto:mikesellsut@gmail.com?subject=Properties%20for%20Debbie%20Hennessy" class="inline-block text-center border border-gold text-gold font-semibold uppercase tracking-wide text-sm px-4 py-3 rounded hover:bg-gold hover:text-navy">Email mikesellsut@gmail.com</a>
        </div>
        <div class="mt-5 bg-white rounded px-3 py-2 inline-block">
          <Image src={heritageLogo} alt="Heritage Realty Group, LLC" width={200} class="h-10 w-auto" />
        </div>
      </div>
    </div>
    <p class="max-w-6xl mx-auto mt-8 text-xs text-navy/50 leading-relaxed">
      Listing photos and listing data: UtahRealEstate.com. Copyright © UtahRealEstate.com. All rights reserved.
    </p>
  </section>
</BaseLayout>
