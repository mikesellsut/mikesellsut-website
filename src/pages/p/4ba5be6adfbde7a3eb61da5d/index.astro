---
// PRIVATE, LINK-ONLY PAGE. Not linked from the nav, footer, llms.txt, or any
// other page. Excluded from the sitemap (astro.config.mjs "/p/" filter).
// noindex/nofollow meta + X-Robots-Tag (netlify.toml "/p/*").
// Cards are rendered from ./listings.json. Do not hard-code listings here.
// See _README.md in this folder for the update procedure.
import { existsSync } from "node:fs";
import { join } from "node:path";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PhotoLightbox from "../../../components/PhotoLightbox.astro";
import heritageLogo from "../../../assets/heritage-logo.png";
import listingFile from "./listings.json";
import pageMeta from "./page_meta.json";

const base = "/p/4ba5be6adfbde7a3eb61da5d";
const photoDir = join(process.cwd(), "public", "p", "4ba5be6adfbde7a3eb61da5d", "photos");

interface Listing {
  hrg_code: string;
  name: string;
  area: string;
  county: string;
  acres: number;
  price: number;
  price_per_acre: number;
  tier: string;
  water_note: string;
  has_water: boolean;
  forest_note: string;
  short_description: string;
  buildings: string;
  hero_photo: string | null;
  photos: string[];
  badge: string | null;
  featured: boolean;
  sort_priority: number;
  courtesy_brokerage: string | null;
}

const money = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});
const acresText = (n: number) =>
  new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 }).format(n);

/** NAR mark, applied when the word appears in text we print. */
function withRealtorMark(text: string): string {
  return text.replace(/realtors?(?!®)/gi, (word) =>
    word.toLowerCase() === "realtors" ? "REALTORS®" : "REALTOR®",
  );
}

function galleryOf(listing: Listing): string[] {
  const photos = listing.photos ?? [];
  if (listing.hero_photo && photos.includes(listing.hero_photo)) {
    return [listing.hero_photo, ...photos.filter((file) => file !== listing.hero_photo)];
  }
  if (listing.hero_photo) return [listing.hero_photo, ...photos];
  return photos;
}

function yesNo(value: string): string {
  if (value.toLowerCase() === "yes") return "Yes";
  if (value.toLowerCase() === "no") return "No";
  return value;
}

const renderedFields = [
  "name",
  "area",
  "county",
  "short_description",
  "forest_note",
  "water_note",
  "courtesy_brokerage",
  "badge",
  "tier",
  "buildings",
] as const;

const listings: Listing[] = (listingFile.listings as Listing[]).slice().sort((a, b) => {
  if (a.sort_priority !== b.sort_priority) return a.sort_priority - b.sort_priority;
  return b.acres - a.acres;
});

for (const listing of listings) {
  for (const field of renderedFields) {
    const value = listing[field];
    if (typeof value !== "string" || value.length === 0) continue;
    if (/utahrealestate|https?:\/\/|www\./i.test(value)) {
      throw new Error(`${listing.hrg_code} ${field} contains a link or listing-site name`);
    }
    if (/\bMLS\b|\boff[-\s]?market\b/i.test(value)) {
      throw new Error(`${listing.hrg_code} ${field} contains MLS or off-market wording`);
    }
    if (/\b\d{7}\b/.test(value)) {
      throw new Error(`${listing.hrg_code} ${field} contains a 7-digit number`);
    }
  }
  for (const file of galleryOf(listing)) {
    if (!existsSync(join(photoDir, file))) {
      throw new Error(`Missing photo ${file} for ${listing.hrg_code}`);
    }
  }
}

const contact = pageMeta.contact;
const phoneHref = `tel:${contact.phone.replace(/[^\d+]/g, "")}`;
const pageMailHref = `mailto:${contact.email}?subject=${encodeURIComponent("Private ranch and recreation listings")}`;
const tierOrder = ["Strong", "Good", "Other"];
const tiers = [...new Set(listings.map((listing) => listing.tier))].sort((a, b) => {
  const ai = tierOrder.indexOf(a);
  const bi = tierOrder.indexOf(b);
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});
const counties = [...new Set(listings.map((listing) => listing.county))].sort((a, b) =>
  a.localeCompare(b),
);
const priceSpan = listings.reduce(
  (span, listing) => ({
    min: Math.min(span.min, listing.price),
    max: Math.max(span.max, listing.price),
  }),
  { min: Infinity, max: 0 },
);
const acreSpan = listings.reduce(
  (span, listing) => ({
    min: Math.min(span.min, listing.acres),
    max: Math.max(span.max, listing.acres),
  }),
  { min: Infinity, max: 0 },
);

const firstHero = listings.map(galleryOf).find((photos) => photos.length > 0)?.[0];
const disclaimer = `${pageMeta.disclaimer} Agent License ${contact.agent_license} · Brokerage License ${contact.brokerage_license}.`;
---

<BaseLayout
  title="Private Ranch & Recreation Listings | MikeSellsUT"
  exactTitle={true}
  description="Private ranch and recreation listings presented by Mike Price, Sales Agent, Heritage Realty Group. Filter by price, acres, county, water, and buildings, then contact Mike for a private showing."
  image={firstHero ? `${base}/photos/${firstHero}` : "/images/site/mike-headshot.jpg"}
  noindex={true}
>
  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
        <img
          src="/images/site/mike-headshot.jpg"
          alt="Mike Price, Sales Agent, Heritage Realty Group"
          width="400"
          height="600"
          class="h-20 w-20 shrink-0 rounded-full border-2 border-gold object-cover sm:h-24 sm:w-24"
          decoding="async"
        />
        <div class="min-w-0 flex-1">
          <p class="font-heading text-xs uppercase tracking-[0.2em] text-gold sm:text-sm">
            Heritage Realty Group · MikeSellsUT
          </p>
          <h1 class="mt-1 font-display text-3xl leading-tight text-white sm:text-4xl md:text-5xl">
            Private Ranch &amp; Recreation Listings
          </h1>
          <p class="mt-3 text-cream">
            {contact.name}, {contact.title}
          </p>
          <p class="text-cream/90">{contact.brokerage}</p>
          <p class="mt-3 flex flex-col gap-1 text-sm sm:flex-row sm:flex-wrap sm:gap-x-4">
            <a href={phoneHref} class="text-gold hover:text-white">{contact.phone}</a>
            <a href={pageMailHref} class="break-all text-gold hover:text-white">{contact.email}</a>
            <a href={contact.website} class="text-gold hover:text-white">{contact.website_label}</a>
          </p>
        </div>
        <div class="self-start rounded bg-white px-3 py-2">
          <Image
            src={heritageLogo}
            alt="Heritage Realty Group"
            width={800}
            height={198}
            class="h-10 w-auto sm:h-12"
          />
        </div>
      </div>
    </div>
  </section>
  <div class="h-1 bg-gold"></div>

  <section class="px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <form id="listing-filters" class="mx-auto max-w-6xl rounded-lg border border-navy/10 bg-white p-4 shadow-sm sm:p-6">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="font-display text-2xl text-navy">Filter the list</h2>
          <p class="mt-1 text-sm text-navy/80">
            {listings.length} properties. Default order is the prepared sort, then larger acreage first.
          </p>
        </div>
        <button
          type="reset"
          class="inline-flex min-h-11 items-center justify-center rounded border border-navy/20 px-4 py-2 text-sm font-semibold text-navy hover:border-navy hover:bg-cream"
        >
          Reset filters
        </button>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="block text-sm font-semibold text-navy sm:col-span-2 lg:col-span-4">
          Search name, area, or description
          <input
            id="filter-q"
            type="search"
            name="q"
            placeholder="Keyword"
            autocomplete="off"
            class="mt-1 w-full min-h-11 rounded border border-navy/20 px-3 text-base text-navy"
          />
        </label>
        <label class="block text-sm font-semibold text-navy">
          Minimum price
          <input id="filter-price-min" name="price-min" type="number" inputmode="numeric" min="0" step="1000" placeholder={money.format(priceSpan.min)} class="mt-1 w-full min-h-11 rounded border border-navy/20 px-3 text-base" />
        </label>
        <label class="block text-sm font-semibold text-navy">
          Maximum price
          <input id="filter-price-max" name="price-max" type="number" inputmode="numeric" min="0" step="1000" placeholder={money.format(priceSpan.max)} class="mt-1 w-full min-h-11 rounded border border-navy/20 px-3 text-base" />
        </label>
        <label class="block text-sm font-semibold text-navy">
          Minimum acres
          <input id="filter-acres-min" name="acres-min" type="number" inputmode="decimal" min="0" step="1" placeholder={acresText(acreSpan.min)} class="mt-1 w-full min-h-11 rounded border border-navy/20 px-3 text-base" />
        </label>
        <label class="block text-sm font-semibold text-navy">
          Maximum acres
          <input id="filter-acres-max" name="acres-max" type="number" inputmode="decimal" min="0" step="1" placeholder={acresText(acreSpan.max)} class="mt-1 w-full min-h-11 rounded border border-navy/20 px-3 text-base" />
        </label>
        <label class="block text-sm font-semibold text-navy">
          Water
          <select id="filter-water" name="water" class="mt-1 w-full min-h-11 rounded border border-navy/20 bg-white px-3 text-base">
            <option value="">Any</option>
            <option value="yes">Has water</option>
            <option value="no">No water</option>
          </select>
        </label>
        <label class="block text-sm font-semibold text-navy">
          Buildings
          <select id="filter-buildings" name="buildings" class="mt-1 w-full min-h-11 rounded border border-navy/20 bg-white px-3 text-base">
            <option value="">Any</option>
            <option value="yes">Yes</option>
            <option value="no">No</option>
          </select>
        </label>
        <label class="block text-sm font-semibold text-navy sm:col-span-2">
          Sort
          <select id="filter-sort" name="sort" class="mt-1 w-full min-h-11 rounded border border-navy/20 bg-white px-3 text-base">
            <option value="recommended">Recommended</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="acres-asc">Acres: low to high</option>
            <option value="acres-desc">Acres: high to low</option>
            <option value="ppa-asc">$/acre: low to high</option>
            <option value="ppa-desc">$/acre: high to low</option>
          </select>
        </label>
      </div>

      <fieldset class="mt-4">
        <legend class="text-sm font-semibold text-navy">Tier</legend>
        <p class="mt-1 text-xs text-navy/70">Check one or more. If none are checked, every tier is included.</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {tiers.map((tier) => (
            <label class="inline-flex min-h-11 items-center gap-2 rounded-full border border-navy/15 bg-cream px-3 py-1.5 text-sm font-semibold text-navy">
              <input type="checkbox" name="tier" value={tier} class="h-4 w-4 accent-navy" />
              {tier}
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="mt-4">
        <legend class="text-sm font-semibold text-navy">County</legend>
        <p class="mt-1 text-xs text-navy/70">Check one or more. If none are checked, every county is included.</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" id="county-all" class="min-h-11 rounded border border-navy/20 px-3 text-sm font-semibold text-navy hover:bg-cream">Select all</button>
          <button type="button" id="county-clear" class="min-h-11 rounded border border-navy/20 px-3 text-sm font-semibold text-navy hover:bg-cream">Clear</button>
        </div>
        <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {counties.map((county) => (
            <label class="flex min-h-11 items-center gap-2 rounded border border-navy/10 px-3 py-2 text-sm text-navy">
              <input type="checkbox" name="county" value={county} class="h-4 w-4 accent-navy" />
              {county}
            </label>
          ))}
        </div>
      </fieldset>
    </form>
  </section>

  <div class="sticky top-16 z-30 border-y border-navy/10 bg-cream/95 backdrop-blur md:top-20">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2 sm:px-6 lg:px-8">
      <p id="result-count" class="text-sm font-semibold text-navy" aria-live="polite">
        Showing {listings.length} of {listings.length}
      </p>
      <a href="#listing-filters" class="text-sm font-semibold text-navy underline decoration-gold decoration-2 underline-offset-4">Filters</a>
    </div>
  </div>

  <section class="px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div id="listing-cards" class="mx-auto flex max-w-6xl flex-col gap-6">
      <p id="listing-empty" hidden class="rounded-lg border border-navy/10 bg-white px-4 py-8 text-center text-navy">
        No properties match these filters.
      </p>
      {listings.map((listing, order) => {
        const photos = galleryOf(listing);
        const hero = photos[0] ?? null;
        const search = `${listing.name} ${listing.area} ${listing.short_description}`.toLowerCase();
        const mailHref = `mailto:${contact.email}?subject=${encodeURIComponent(`${listing.hrg_code} ${listing.name}`)}`;
        const courtesy = listing.courtesy_brokerage
          ? `Listing courtesy of ${withRealtorMark(listing.courtesy_brokerage)}`
          : null;
        const photoLabel = photos.length === 1 ? "1 photo" : `${photos.length} photos`;
        return (
          <article
            id={listing.hrg_code}
            data-card
            data-order={order}
            data-code={listing.hrg_code}
            data-price={listing.price}
            data-acres={listing.acres}
            data-ppa={listing.price_per_acre}
            data-county={listing.county}
            data-tier={listing.tier}
            data-water={listing.has_water ? "yes" : "no"}
            data-buildings={listing.buildings.toLowerCase()}
            data-priority={listing.sort_priority}
            data-search={search}
            class="scroll-mt-28 overflow-hidden rounded-lg border border-navy/10 bg-white shadow-md"
          >
            <div class="grid grid-cols-1 lg:grid-cols-12">
              <div class="relative bg-navy lg:col-span-5">
                {hero ? (
                  <a
                    href={`${base}/photos/${hero}`}
                    data-lightbox={listing.hrg_code}
                    data-full={`${base}/photos/${hero}`}
                    data-alt={withRealtorMark(`${listing.name}, ${listing.area}, ${listing.county}, photo 1 of ${photos.length}`)}
                    class="relative block aspect-[3/2] overflow-hidden lg:absolute lg:inset-0 lg:aspect-auto"
                  >
                    <img
                      src={`${base}/photos/${hero}`}
                      alt={withRealtorMark(`${listing.name}, ${listing.area}, ${listing.county}, photo 1 of ${photos.length}`)}
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="absolute bottom-3 right-3 rounded bg-navy/85 px-2 py-1 text-xs font-semibold text-white">
                      View {photoLabel}
                    </span>
                  </a>
                ) : (
                  <div class="flex aspect-[3/2] flex-col items-center justify-center gap-3 bg-navy px-6 text-center lg:absolute lg:inset-0 lg:aspect-auto" role="img" aria-label={`No photo available for ${listing.name}`}>
                    <Image src={heritageLogo} alt="" aria-hidden="true" width={800} height={198} class="h-12 w-auto" />
                    <p class="font-display text-xl text-white">{listing.name}</p>
                    <p class="font-heading text-xs uppercase tracking-[0.18em] text-gold">Photo coming soon</p>
                  </div>
                )}
                {listing.badge && (
                  <span
                    class:list={[
                      "absolute left-3 top-3 rounded px-2.5 py-1 text-xs font-bold uppercase tracking-wider shadow",
                      listing.badge === "PRICE DROP" ? "bg-red text-white" : "bg-gold text-navy",
                    ]}
                  >
                    {listing.badge}
                  </span>
                )}
              </div>

              <div class="flex flex-col gap-3 p-4 sm:p-6 lg:col-span-7">
                <div>
                  <p class="font-heading text-xs font-semibold uppercase tracking-[0.16em] text-gold">
                    {listing.hrg_code} · {listing.tier}
                  </p>
                  <h2 class="mt-1 font-display text-2xl leading-tight text-navy sm:text-3xl">{listing.name}</h2>
                  <p class="mt-1 text-sm text-navy/80">{listing.area} · {listing.county}</p>
                </div>

                <dl class="grid grid-cols-3 gap-2">
                  <div class="rounded bg-cream px-2 py-2 sm:px-3">
                    <dt class="text-[11px] font-semibold uppercase tracking-wider text-navy/60">Price</dt>
                    <dd class="font-display text-base leading-tight text-navy sm:text-xl lg:text-2xl">{money.format(listing.price)}</dd>
                  </div>
                  <div class="rounded bg-cream px-2 py-2 sm:px-3">
                    <dt class="text-[11px] font-semibold uppercase tracking-wider text-navy/60">Acres</dt>
                    <dd class="font-display text-base leading-tight text-navy sm:text-xl lg:text-2xl">{acresText(listing.acres)}</dd>
                  </div>
                  <div class="rounded bg-cream px-2 py-2 sm:px-3">
                    <dt class="text-[11px] font-semibold uppercase tracking-wider text-navy/60">$/acre</dt>
                    <dd class="font-display text-base leading-tight text-navy sm:text-xl lg:text-2xl">{money.format(listing.price_per_acre)}</dd>
                  </div>
                </dl>

                <ul class="flex flex-wrap gap-2 text-sm font-semibold text-navy">
                  <li class="rounded-full border border-navy/15 px-3 py-1">Tier: {listing.tier}</li>
                  <li class="rounded-full border border-navy/15 px-3 py-1">Buildings: {yesNo(listing.buildings)}</li>
                  <li class="rounded-full border border-navy/15 px-3 py-1">{photoLabel}</li>
                </ul>

                <p class="text-sm leading-relaxed text-navy">
                  <span class="font-semibold">Water: </span>{listing.water_note}
                </p>
                <p class="leading-relaxed text-navy/90">{listing.short_description}</p>

                <details class="rounded border border-navy/10 bg-cream/60 px-3 py-2">
                  <summary class="cursor-pointer text-sm font-semibold text-navy">Forest and land notes</summary>
                  <p class="mt-2 text-sm leading-relaxed text-navy/90">{listing.forest_note}</p>
                </details>

                <div class="mt-1 rounded-lg border border-navy/10 bg-cream p-3">
                  <div class="flex flex-col gap-2 sm:flex-row">
                    <a
                      href={mailHref}
                      class="inline-flex min-h-11 flex-1 items-center justify-center rounded bg-gold px-4 py-2 text-center text-sm font-bold uppercase tracking-wide text-navy hover:bg-navy hover:text-white"
                    >
                      Contact Mike
                    </a>
                    <a
                      href={phoneHref}
                      class="inline-flex min-h-11 flex-1 items-center justify-center rounded border-2 border-navy px-4 py-2 text-center text-sm font-bold uppercase tracking-wide text-navy hover:bg-navy hover:text-white"
                    >
                      Call {contact.phone}
                    </a>
                  </div>
                  <p class="mt-2 text-sm text-navy">{contact.cta_note}</p>
                </div>
              </div>
            </div>

            {photos.length > 1 && (
              <div class="border-t border-navy/10 px-4 py-3 sm:px-6">
                <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-navy/70">All {photoLabel}</p>
                <div class="flex gap-2 overflow-x-auto pb-1">
                  {photos.slice(1).map((file, index) => {
                    const alt = withRealtorMark(`${listing.name}, ${listing.area}, ${listing.county}, photo ${index + 2} of ${photos.length}`);
                    const src = `${base}/photos/${file}`;
                    return (
                      <a
                        href={src}
                        data-lightbox={listing.hrg_code}
                        data-full={src}
                        data-alt={alt}
                        class="block h-16 w-24 shrink-0 overflow-hidden rounded bg-cream"
                      >
                        <img src={src} alt={alt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
                      </a>
                    );
                  })}
                </div>
              </div>
            )}

            {courtesy && (
              <p class="border-t border-navy/10 px-4 py-3 text-sm font-medium text-navy sm:px-6">
                {courtesy}
              </p>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="px-4 pb-10 sm:px-6 lg:px-8">
    <p class="mx-auto max-w-6xl text-sm leading-relaxed text-navy">
      {disclaimer}
    </p>
  </section>

  <PhotoLightbox />
</BaseLayout>

<script>
  const form = document.getElementById("listing-filters");
  const cardsRoot = document.getElementById("listing-cards");
  const countEl = document.getElementById("result-count");
  const emptyEl = document.getElementById("listing-empty");
  const sortEl = document.getElementById("filter-sort") as HTMLSelectElement | null;

  if (form instanceof HTMLFormElement && cardsRoot && countEl && emptyEl && sortEl) {
    const priceMin = document.getElementById("filter-price-min") as HTMLInputElement;
    const priceMax = document.getElementById("filter-price-max") as HTMLInputElement;
    const acresMin = document.getElementById("filter-acres-min") as HTMLInputElement;
    const acresMax = document.getElementById("filter-acres-max") as HTMLInputElement;
    const waterEl = document.getElementById("filter-water") as HTMLSelectElement;
    const buildingsEl = document.getElementById("filter-buildings") as HTMLSelectElement;
    const queryEl = document.getElementById("filter-q") as HTMLInputElement;

    const num = (el: HTMLElement, key: string) => Number(el.dataset[key]);
    const bound = (input: HTMLInputElement) => {
      const raw = input.value.trim();
      if (raw === "") return null;
      const value = Number(raw);
      return Number.isFinite(value) ? value : null;
    };
    const checkedValues = (name: string) =>
      [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((input) => input.value);

    const recommended = (a: HTMLElement, b: HTMLElement) =>
      num(a, "priority") - num(b, "priority") ||
      num(b, "acres") - num(a, "acres") ||
      num(a, "order") - num(b, "order");

    const compare = (a: HTMLElement, b: HTMLElement) => {
      const mode = sortEl.value;
      const by = (key: string, dir: 1 | -1) => dir * (num(a, key) - num(b, key)) || recommended(a, b);
      if (mode === "price-asc") return by("price", 1);
      if (mode === "price-desc") return by("price", -1);
      if (mode === "acres-asc") return by("acres", 1);
      if (mode === "acres-desc") return by("acres", -1);
      if (mode === "ppa-asc") return by("ppa", 1);
      if (mode === "ppa-desc") return by("ppa", -1);
      return recommended(a, b);
    };

    const matches = (card: HTMLElement) => {
      const minPrice = bound(priceMin);
      const maxPrice = bound(priceMax);
      const minAcres = bound(acresMin);
      const maxAcres = bound(acresMax);
      if (minPrice !== null && num(card, "price") < minPrice) return false;
      if (maxPrice !== null && num(card, "price") > maxPrice) return false;
      if (minAcres !== null && num(card, "acres") < minAcres) return false;
      if (maxAcres !== null && num(card, "acres") > maxAcres) return false;
      const tiers = checkedValues("tier");
      if (tiers.length && !tiers.includes(card.dataset.tier || "")) return false;
      const counties = checkedValues("county");
      if (counties.length && !counties.includes(card.dataset.county || "")) return false;
      if (waterEl.value && card.dataset.water !== waterEl.value) return false;
      if (buildingsEl.value && card.dataset.buildings !== buildingsEl.value) return false;
      const words = queryEl.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const haystack = card.dataset.search || "";
      if (words.some((word) => !haystack.includes(word))) return false;
      return true;
    };

    const apply = () => {
      const cards = [...cardsRoot.querySelectorAll<HTMLElement>("[data-card]")];
      cards.sort(compare);
      let shown = 0;
      for (const card of cards) {
        const ok = matches(card);
        card.hidden = !ok;
        if (ok) shown += 1;
        cardsRoot.appendChild(card);
      }
      if (emptyEl.parentElement === cardsRoot) cardsRoot.appendChild(emptyEl);
      countEl.textContent = `Showing ${shown} of ${cards.length}`;
      emptyEl.hidden = shown !== 0;
    };

    form.addEventListener("submit", (event) => event.preventDefault());
    form.addEventListener("input", apply);
    form.addEventListener("change", apply);
    form.addEventListener("reset", () => requestAnimationFrame(apply));
    document.getElementById("county-all")?.addEventListener("click", () => {
      form.querySelectorAll<HTMLInputElement>('input[name="county"]').forEach((input) => {
        input.checked = true;
      });
      apply();
    });
    document.getElementById("county-clear")?.addEventListener("click", () => {
      form.querySelectorAll<HTMLInputElement>('input[name="county"]').forEach((input) => {
        input.checked = false;
      });
      apply();
    });
    apply();
  }
</script>
